---
// The Confluence Mark — three strokes converging to a point where the
// Thames, the Brent and the Grand Union Canal meet. Signature device (brief §4).
// Used as logo mark, section divider, and hero draw-on.
interface Props {
  class?: string;
  draw?: boolean;      // enable the CSS draw-on animation
  title?: string;
}
const { class: cls, draw = false, title } = Astro.props;
---
<svg
  class:list={[cls, draw && 'mark-draw']}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <path d="M6 6 C 14 20, 20 30, 24 42" />
  <path d="M24 4 L 24 42" />
  <path d="M42 6 C 34 20, 28 30, 24 42" />
</svg>
