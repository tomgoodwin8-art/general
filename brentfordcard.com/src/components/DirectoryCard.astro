---
import BizImage from './BizImage.astro';
import { categoryName } from '../data/site';
interface Props { entry: { id: string; data: any }; seed?: number; }
const { entry, seed = 0 } = Astro.props;
const { data } = entry;
const href = `/directory/${data.category}/${entry.id}/`;
const liveOffer = data.offer && data.offer !== 'pending';
const pending = data.offer === 'pending';
---
<a class="dir-card" href={href}>
  <div class="dir-card__media">
    {data.image
      ? <img src={data.image} width="400" height="300" loading="lazy" decoding="async" alt={data.name} />
      : <BizImage motif={data.motif} category={data.category} ratio="4 / 3" seed={seed} />}
    {liveOffer && <span class="dir-card__badge">Card offer</span>}
    {pending && <span class="dir-card__badge dir-card__badge--pending">Offer pending</span>}
  </div>
  <div class="dir-card__body">
    <span class="eyebrow dir-card__cat">{categoryName(data.category)}</span>
    <span class="dir-card__name">{data.name}</span>
    {data.founding && <span class="pill tag-founding" style="margin-top:auto; align-self:flex-start;">Founding business</span>}
  </div>
</a>
