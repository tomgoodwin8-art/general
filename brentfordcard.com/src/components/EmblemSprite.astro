---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {Object.entries(EMBLEMS).map(([key, paths]) => (
      <symbol id={`emb-${key}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        {paths.map((d) => <path d={d} />)}
      </symbol>
    ))}
  </defs>
</svg>
