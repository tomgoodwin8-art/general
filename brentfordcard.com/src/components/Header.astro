---
import { NAV } from '../data/site';
import ConfluenceMark from './ConfluenceMark.astro';
const here = Astro.url.pathname;
const isActive = (href: string) => here === href || (href !== '/' && here.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="Brentford Card home">
      <ConfluenceMark class="brand__mark" title="Brentford Card" />
      <span class="brand__word">Brentford Card</span>
    </a>

    <nav class="nav nav__desktop" aria-label="Primary">
      <div class="nav__links" style="display:flex; gap:clamp(0.9rem,2vw,1.6rem); align-items:center;">
        {NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
      <a class="btn btn--brass nav__cta" href="/card/">Get the card</a>
    </nav>

    <details class="mobile-nav">
      <summary class="nav-toggle" aria-label="Open menu">Menu</summary>
      <div class="mobile-nav__sheet">
        {NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="btn btn--brass" href="/card/" style="margin-top:0.5rem; justify-content:center;">Get the card</a>
      </div>
    </details>
  </div>
</header>
