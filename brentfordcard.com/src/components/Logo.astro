---
// Brentford Card logo mark: a "B" on a rounded card rectangle (echoes the
// membership card). `solid` = river-green fill (light backgrounds);
// `ghost` = brass outline only (for dark / green backgrounds like the pass).
interface Props {
  class?: string;
  title?: string;
  variant?: 'solid' | 'ghost';
}
const { class: cls, title, variant = 'solid' } = Astro.props;
const ghost = variant === 'ghost';
---
<svg
  class={cls}
  viewBox="0 0 44 32"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <rect x="1" y="1" width="42" height="30" rx="6" fill={ghost ? 'none' : '#2e4a43'} />
  <rect
    x="3" y="3" width="38" height="26" rx="4.5"
    fill="none" stroke="#b08d3e" stroke-width={ghost ? 1.4 : 1.1}
    opacity={ghost ? 0.9 : 0.55}
  />
  <text
    x="22" y="23.5"
    text-anchor="middle"
    font-family="'Archivo Variable', 'Archivo', Arial, sans-serif"
    font-weight="800"
    font-size="21"
    fill="#b08d3e"
  >B</text>
</svg>
