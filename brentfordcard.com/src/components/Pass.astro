---
import Logo from './Logo.astro';
// The Brentford Card, rendered as a crisp CSS/SVG composition (brief §4).
// Doubles as the press-kit asset — no raster mockup.
interface Props { name?: string; id?: string; }
const { name = 'Member Name', id = 'BFC-0001' } = Astro.props;
---
<div class="pass" role="img" aria-label="The Brentford Card — member pass">
  <!-- Stylised river meander (Thames · Brent · Grand Union) in brand gold. -->
  <svg class="pass__river" viewBox="0 0 340 214" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="pass-river-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8a6f30" />
        <stop offset="0.5" stop-color="#cbab5c" />
        <stop offset="1" stop-color="#b08d3e" />
      </linearGradient>
    </defs>
    <path d="M-30 96 C 55 58, 82 132, 158 116 C 238 99, 214 48, 302 68 C 348 78, 352 116, 392 126"
      fill="none" stroke="url(#pass-river-gold)" stroke-width="16" stroke-linecap="round" opacity="0.78" />
    <path d="M-30 128 C 60 104, 90 156, 170 142 C 250 128, 236 92, 320 106"
      fill="none" stroke="#cbab5c" stroke-width="3" stroke-linecap="round" opacity="0.3" />
  </svg>

  <div class="pass__top">
    <div class="pass__brand">
      <Logo variant="ghost" />
      <span>Brentford Card</span>
    </div>
    <span class="pass__tier">Member</span>
  </div>

  <div class="pass__name">
    <small>Member</small>
    {name}
  </div>

  <div class="pass__bottom">
    <div class="pass__meta">
      No. {id}<br />
      Valid TW8 · 2026–27
    </div>
    <div class="pass__qr">
      <!-- Decorative QR glyph; the live pass carries a scannable code. -->
      <svg viewBox="0 0 29 29" fill="currentColor" aria-hidden="true">
        <path d="M0 0h9v9H0zM2 2v5h5V2zM20 0h9v9h-9zM22 2v5h5V2zM0 20h9v9H0zM2 22v5h5v-5z"/>
        <path d="M11 0h2v2h-2zM15 0h2v4h-2zM11 4h4v2h-2v3h-2zM24 11h5v2h-2v2h-2v-2h-1zM11 11h2v2h-2zM17 11h2v2h-2zM20 15h2v2h-2zM11 15h4v2h-4zM24 17h5v2h-5zM11 19h2v4h-2zM15 20h2v2h2v2h-4zM20 22h4v2h-4zM24 24h5v5h-2v-3h-3zM15 25h2v4h-2zM19 26h2v3h-2z"/>
      </svg>
    </div>
  </div>
</div>
