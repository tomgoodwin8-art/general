---
import ConfluenceMark from './ConfluenceMark.astro';
// Placeholder poster used until commissioned photography lands (brief §5).
// Renders a crisp river-toned SVG composition — zero CLS at any DPR, no binary
// asset needed. Swap for a Cloudflare Images <img srcset> when photos arrive.
interface Props {
  label?: string;
  ratio?: string;      // e.g. "4 / 3"
  tone?: 'river' | 'brass' | 'brick' | 'ink';
  seed?: number;
  class?: string;
}
const { label, ratio = '4 / 3', tone = 'river', seed = 0, class: cls } = Astro.props;
const tones: Record<string, [string, string]> = {
  river: ['#2e4a43', '#1a2c28'],
  brass: ['#8a6f30', '#5c4a20'],
  brick: ['#7e4a34', '#4d2d20'],
  ink: ['#101614', '#0a0d0c'],
};
const [c1, c2] = tones[tone] ?? tones.river;
const angle = 120 + (seed % 5) * 12;
---
<div class:list={['poster', cls]} style={`aspect-ratio:${ratio}`} aria-hidden="true">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id={`g${seed}`} gradientTransform={`rotate(${angle} 0.5 0.5)`}>
        <stop offset="0" stop-color={c1} />
        <stop offset="1" stop-color={c2} />
      </linearGradient>
    </defs>
    <rect width="400" height="300" fill={`url(#g${seed})`} />
    <g stroke="rgba(242,238,230,0.10)" stroke-width="1" fill="none">
      <path d={`M0 ${120 + (seed % 4) * 20} Q200 ${60 + (seed % 3) * 30} 400 ${140 + (seed % 4) * 15}`} />
      <path d={`M0 ${180 + (seed % 3) * 15} Q200 ${140 + (seed % 4) * 20} 400 ${200 + (seed % 3) * 10}`} />
    </g>
  </svg>
  <div class="poster__mark"><ConfluenceMark /></div>
  {label && <span class="poster__label">{label}</span>}
</div>

<style>
  .poster { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--river); }
  .poster > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster__mark { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(242,238,230,0.22); }
  .poster__mark :global(svg) { width: 22%; height: auto; }
  .poster__label {
    position: absolute; left: 12px; bottom: 10px; right: 12px;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em;
    color: rgba(242,238,230,0.6); text-transform: uppercase;
  }
</style>
