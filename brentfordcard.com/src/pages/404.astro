---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { CATEGORIES } from '../data/site';
---
<BaseLayout
  title="Page not found | The Brentford Card"
  description="That page could not be found. Browse the Brentford directory, news, or the card."
  path="/404/"
  noindex={true}
>
  <section class="section wrap center" style="max-width:640px;">
    <div class="confluence-divider"><Logo /></div>
    <p class="eyebrow">404</p>
    <h1 class="page-title">This one's gone downstream</h1>
    <p class="lead" style="margin-inline:auto;">We couldn't find that page. Try the directory or the news instead.</p>

    <div class="chips" style="justify-content:center; margin-top:2rem;">
      <a class="chip" href="/directory/">All businesses</a>
      {CATEGORIES.map((c) => <a class="chip" href={`/directory/${c.slug}/`}>{c.name}</a>)}
    </div>
    <p style="margin-top:2rem;"><a class="btn btn--river" href="/">Back home</a> <a class="btn btn--ghost" href="/news/" style="margin-left:0.5rem;">Read the news</a></p>
  </section>
</BaseLayout>
