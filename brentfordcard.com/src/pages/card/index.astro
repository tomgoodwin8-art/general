---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Pass from '../../components/Pass.astro';
import { SITE, CARD } from '../../data/site';
import { CARD_FAQ } from '../../data/faq';
import { breadcrumbList, cardProduct, faqPage } from '../../lib/schema';

const allBiz = (await getCollection('directory'))
  .filter((l) => l.data.offer)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const participating = allBiz;
const totalBiz = allBiz.length;

const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'The Brentford Card', path: '/card/' },
];
const schema = [cardProduct(), faqPage(CARD_FAQ.map((f) => ({ q: f.q, a: f.a }))), breadcrumbList(crumbs)];
---
<BaseLayout
  title="The Brentford Card | Brentford discount card, £29/year"
  description={`The Brentford Card is a £29/year discount card for Brentford (TW8), delivered to your Apple or Google Wallet. ${CARD.charityPct}% goes to a local cause.`}
  path="/card/"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media">
      <svg class="hero__poster" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs><linearGradient id="cg" x1="0" y1="0" x2="0.5" y2="1"><stop offset="0" stop-color="#365a51"/><stop offset="1" stop-color="#16241f"/></linearGradient></defs>
        <rect width="1440" height="700" fill="url(#cg)"/>
        <g fill="none" stroke="rgba(242,238,230,0.09)" stroke-width="2"><path d="M0 420 Q720 300 1440 460"/><path d="M0 520 Q720 420 1440 560"/></g>
      </svg>
    </div>
    <div class="wrap hero__inner">
      <div class="grid grid--2" style="align-items:center; gap:3rem;">
        <div>
          <p class="eyebrow eyebrow--onriver">The Brentford Card</p>
          <h1 style="font-size:var(--step-h1);">A discount card for the whole of TW8</h1>
          <p class="lead">{CARD.priceDisplay} a year. Offers at independent Brentford businesses, in your phone wallet. {CARD.charityPct}% of every card goes to {CARD.charityName}.</p>
          <p style="margin-top:1.5rem; display:flex; gap:0.8rem; flex-wrap:wrap; align-items:center;">
            <form method="post" action="/api/checkout" style="margin:0;">
              <button class="btn btn--brass" type="submit">Buy the card — {CARD.priceDisplay}</button>
            </form>
            <a class="btn btn--ghost-light" href="#faq">Read the FAQ</a>
          </p>
          <p class="mono" style="color:var(--brass); margin-top:1.25rem;">{CARD.charityPct}% of every card supports {CARD.charityName}.</p>
        </div>
        <div style="display:grid; place-items:center;">
          <Pass name="A. Resident" />
        </div>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section wrap">
    <div class="grid grid--3">
      <div class="value-card"><span class="value-card__num">1</span><h3>Real discounts</h3><p class="muted">Discounts rolling out across {totalBiz} Brentford independents — food, shops, health, fitness, services and culture.</p></div>
      <div class="value-card"><span class="value-card__num">2</span><h3>In your wallet</h3><p class="muted">Delivered as an Apple or Google Wallet pass. Nothing to download, nothing to carry, nothing to lose.</p></div>
      <div class="value-card"><span class="value-card__num">3</span><h3>Backs Brentford</h3><p class="muted">{CARD.charityPct}% of every membership goes to {CARD.charityName}. The rest keeps the directory independent.</p></div>
    </div>
  </section>

  <!-- Charity line -->
  <section class="section--tight wrap">
    <div class="panel">
      <p class="eyebrow" style="color:var(--brass);">The charity commitment</p>
      <p style="font-size:var(--step-lead); max-width:60ch; color:var(--plaster);">Ten per cent of every Brentford Card goes to {CARD.charityName}. It is written into how the scheme runs, not a launch promotion — buy a card and you back a Brentford cause every year you renew.</p>
    </div>
  </section>

  <!-- Participating businesses wall -->
  <section class="section--tight wrap">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
      <div><p class="eyebrow">Where it works</p><h2>{totalBiz} businesses lined up for the card</h2></div>
      <a class="link" href="/directory/">Full directory →</a>
    </div>
    <ul class="grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr)); margin-top:1.75rem; list-style:none; padding:0;">
      {participating.map((b) => (
        <li>
          <a class="panel-plaster" href={`/directory/${b.data.category}/${b.id}/`} style="display:block; text-decoration:none; color:inherit; padding:0.9rem 1.1rem;">
            <span class="dir-card__name" style="display:block; font-size:1rem;">{b.data.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="section wrap" id="faq">
    <p class="eyebrow">Questions</p>
    <h2>Brentford Card FAQ</h2>
    <div class="faq" style="margin-top:1.5rem; max-width:820px;">
      {CARD_FAQ.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div>{f.a}</div>
        </details>
      ))}
    </div>
    <form method="post" action="/api/checkout" style="margin-top:2rem;">
      <button class="btn btn--brass" type="submit">Buy the card — {CARD.priceDisplay}/year</button>
    </form>
  </section>
</BaseLayout>
