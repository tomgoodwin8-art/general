---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Pass from '../../components/Pass.astro';
import { SITE, CARD } from '../../data/site';
---
<BaseLayout
  title="You're in | The Brentford Card"
  description="Thank you for joining the Brentford Card. Your Apple or Google Wallet pass arrives by email within minutes."
  path="/card/success/"
  noindex={true}
>
  <section class="section wrap center" style="max-width:720px;">
    <div class="confluence-divider"><Logo title="Brentford Card" /></div>
    <p class="eyebrow">Welcome to the card</p>
    <h1 class="page-title">You're a Brentford Card member</h1>
    <p class="lead" style="margin-inline:auto;">Thank you — and welcome. Your Apple or Google Wallet pass arrives by email within minutes. Add it to your wallet, then start using offers across TW8.</p>

    <div style="display:grid; place-items:center; margin:2.5rem 0;">
      <Pass name="New Member" founding={true} />
    </div>

    {/* Wallet section — populated client-side from ?session_id= (checkout page
        is permitted client JS per brief §2). */}
    <div id="wallet" class="panel-plaster" style="text-align:left;">
      <div id="wallet-loading">
        <p class="eyebrow">Preparing your pass</p>
        <p class="muted" style="margin-top:0.5rem;">One moment while we issue your Brentford Card…</p>
      </div>

      <div id="wallet-ready" hidden>
        <p class="eyebrow">Add your card</p>
        <p style="margin:0.5rem 0 1.25rem;">Your membership number is <strong id="wallet-card" class="mono"></strong>. Add the pass to your phone:</p>
        <p style="display:flex; gap:0.8rem; flex-wrap:wrap;">
          <a id="btn-apple" class="btn btn--river" href="#">Add to Apple Wallet</a>
          <a id="btn-google" class="btn btn--ghost" href="#">Add to Google Wallet</a>
        </p>
        <p class="muted" style="margin-top:1rem;">Open this page on your phone to add the pass directly. We've also emailed the link to you.</p>
      </div>

      <div id="wallet-pending" hidden>
        <p class="eyebrow">Almost there</p>
        <p class="muted" style="margin-top:0.5rem;">Your payment is confirmed. Your pass link is on its way by email from {SITE.email} — if it hasn't arrived in a few minutes, <a class="link" href="/contact/">get in touch</a>.</p>
      </div>
    </div>

    <p style="margin-top:2rem;"><a class="btn btn--ghost" href="/directory/">Browse the directory</a></p>
  </section>

  <script>
    const params = new URLSearchParams(location.search);
    const sessionId = params.get('session_id');
    const $ = (id: string) => document.getElementById(id)!;
    const show = (id: string) => { $('wallet-loading').hidden = true; $(id).hidden = false; };

    async function load() {
      if (!sessionId) { show('wallet-pending'); return; }
      // Poll briefly while the webhook provisions the pass.
      for (let i = 0; i < 6; i++) {
        try {
          const res = await fetch(`/api/pass/by-session?session_id=${encodeURIComponent(sessionId)}`);
          if (res.ok) {
            const data = await res.json();
            if (data.ready) {
              (($('btn-apple') as HTMLAnchorElement)).href = `/api/pass/apple/${data.serial}?t=${data.token}`;
              (($('btn-google') as HTMLAnchorElement)).href = `/api/pass/google/${data.serial}?t=${data.token}`;
              $('wallet-card').textContent = data.cardNumber;
              show('wallet-ready');
              return;
            }
          }
        } catch { /* retry */ }
        await new Promise((r) => setTimeout(r, 1500));
      }
      show('wallet-pending');
    }
    load();
  </script>
</BaseLayout>
