---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';
import { breadcrumbList } from '../lib/schema';
const crumbs = [{ label: 'Home', path: '/' }, { label: 'Contact', path: '/contact/' }];
---
<BaseLayout
  title="Contact | The Brentford Card"
  description="Contact the Brentford Card — for members, businesses wanting to list, and press. Direct email and a contact form."
  path="/contact/"
  schema={breadcrumbList(crumbs)}
>
  <section class="section wrap" style="max-width:820px;">
    <Breadcrumb items={crumbs} />
    <p class="eyebrow" style="margin-top:1rem;">Contact</p>
    <h1 class="page-title">Get in touch</h1>
    <p class="lead">Member question, a business that wants to list, or a press enquiry — here's the quickest way to reach us. We reply within two working days.</p>

    <div class="grid grid--2" style="align-items:start; gap:2.5rem; margin-top:2.5rem;">
      <form class="stack" method="post" action="/api/contact" novalidate>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="subject">I'm a…</label>
          <select id="subject" name="subject" required>
            <option value="member">Member or resident</option>
            <option value="business">Business — I want to list</option>
            <option value="press">Press or media</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        {/* Honeypot — bots fill it, humans never see it. */}
        <input class="visually-hidden" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="turnstile-slot" data-turnstile aria-hidden="true"></div>
        <button class="btn btn--brass" type="submit">Send message</button>
        <p class="form-note">Protected by Cloudflare Turnstile. We use your details only to reply — see our <a class="link" href="/privacy/">privacy policy</a>.</p>
      </form>

      <aside class="stack-lg">
        <div>
          <p class="eyebrow">Direct email</p>
          <p style="margin-top:0.5rem;"><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p style="margin-top:0.25rem;"><a class="link" href={`mailto:${SITE.pressEmail}`}>{SITE.pressEmail}</a> for press</p>
        </div>
        <div class="panel-plaster">
          <p class="eyebrow">Run a business in TW8?</p>
          <h3 style="margin-top:0.4rem;">List it, free for launch</h3>
          <p class="muted" style="margin-top:0.5rem;">Get a directory profile, a founding badge, and offers in front of Brentford Card members.</p>
          <p style="margin-top:1rem;"><a class="btn btn--river" href="/contact/?subject=business">List your business</a></p>
        </div>
      </aside>
    </div>
  </section>

  {/* Contact form is one of the two pages permitted client JS (brief §2):
      preset the subject from ?subject= and confirm submission without a reload. */}
  <script>
    const params = new URLSearchParams(location.search);
    const subject = params.get('subject');
    const select = document.getElementById('subject') as HTMLSelectElement | null;
    if (subject && select && [...select.options].some((o) => o.value === subject)) {
      select.value = subject;
    }
    if (params.get('sent') === '1') {
      const form = document.querySelector('form[action="/api/contact"]');
      form?.insertAdjacentHTML(
        'beforebegin',
        '<p class="panel-plaster" role="status" style="margin-bottom:1.5rem;">Thanks — your message is in. We reply within two working days.</p>',
      );
    }
  </script>
</BaseLayout>
