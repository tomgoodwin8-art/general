---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BizImage from '../../../components/BizImage.astro';
import ConfluenceMark from '../../../components/ConfluenceMark.astro';
import { categoryName } from '../../../data/site';
import { breadcrumbList, localBusiness } from '../../../lib/schema';

export async function getStaticPaths() {
  const listings = await getCollection('directory');
  return listings.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Articles that mention this listing (internal linking, brief §7).
const related = (await getCollection('news'))
  .filter((a) => a.data.relatedListings.includes(entry.id))
  .sort((a, b) => +new Date(b.data.publishDate) - +new Date(a.data.publishDate));

const catName = categoryName(data.category);
const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Directory', path: '/directory/' },
  { label: catName, path: `/directory/${data.category}/` },
  { label: data.name, path: `/directory/${data.category}/${entry.id}/` },
];
const schema = [localBusiness({ slug: entry.id, data }), breadcrumbList(crumbs)];
const mapHref = data.geo
  ? `https://www.openstreetmap.org/?mlat=${data.geo.lat}&mlon=${data.geo.lng}#map=17/${data.geo.lat}/${data.geo.lng}`
  : `https://www.openstreetmap.org/search?query=${encodeURIComponent(data.address)}`;
---
<BaseLayout
  title={`${data.name} in Brentford | Brentford Directory`}
  description={data.summary.slice(0, 154)}
  path={`/directory/${data.category}/${entry.id}/`}
  schema={schema}
>
  <section class="section wrap">
    <Breadcrumb items={crumbs} />

    <div class="grid" style="grid-template-columns:1fr; gap:2.5rem; margin-top:1.5rem;">
      <div style="display:grid; gap:2.5rem; grid-template-columns:1fr;">
        <header>
          <p class="eyebrow dir-card__cat">{catName}</p>
          <h1 class="page-title">{data.name}</h1>
          {/* Answer-first factual summary (brief §8) */}
          <p class="standfirst" style="margin-top:0.75rem;">{data.summary}</p>
          <div class="chips" style="margin-top:1.25rem;">
            {data.founding && <span class="pill tag-founding">Founding business</span>}
            {data.offer && data.offer !== 'pending' && <span class="pill">Brentford Card offer</span>}
            {data.offer === 'pending' && <span class="pill">Offer pending</span>}
            {data.priceRange && <span class="pill">{data.priceRange}</span>}
          </div>
        </header>

        <div style="border-radius:var(--radius-lg); overflow:hidden; max-width:720px;">
          {data.image
            ? <img src={data.image} width="960" height="640" alt={data.name} fetchpriority="high" />
            : <BizImage motif={data.motif} category={data.category} ratio="3 / 2" seed={5} label={`${data.name} — photography to follow`} />}
        </div>

        <div class="grid grid--2" style="align-items:start; gap:2.5rem;">
          <div class="stack">
            {data.offer && data.offer !== 'pending' && (
              <div class="panel-plaster">
                <p class="eyebrow">Card offer</p>
                <p style="font-size:var(--step-lead); margin-top:0.4rem;">{data.offer}</p>
                {data.offerTerms && <p class="mono muted" style="margin-top:0.6rem;">{data.offerTerms}</p>}
                <p style="margin-top:1rem;"><a class="btn btn--brass" href="/card/">Get the card to use this</a></p>
              </div>
            )}
            {data.offer === 'pending' && (
              <div class="panel-plaster">
                <p class="eyebrow">Card offer</p>
                <p style="font-size:var(--step-lead); margin-top:0.4rem;">Pending</p>
                <p class="muted" style="margin-top:0.6rem;">{data.name} is confirming its Brentford Card offer. Get the card now and you'll be ready the moment it goes live.</p>
                <p style="margin-top:1rem;"><a class="btn btn--brass" href="/card/">Get the card</a></p>
              </div>
            )}
            <div class="prose"><Content /></div>
          </div>

          <aside class="stack">
            <div>
              <p class="eyebrow">Find them</p>
              <p style="margin-top:0.5rem;">{data.address}</p>
              <p style="margin-top:0.5rem; display:flex; gap:1rem; flex-wrap:wrap;">
                <a class="link" href={mapHref} rel="noopener">View map</a>
                {data.phone && <a class="link" href={`tel:${data.phone.replace(/\s/g,'')}`}>{data.phone}</a>}
                {data.website && <a class="link" href={data.website} rel="noopener nofollow">Website</a>}
              </p>
            </div>
            {data.hours?.length > 0 && (
              <div>
                <p class="eyebrow">Opening hours</p>
                <dl class="datalist" style="margin-top:0.5rem;">
                  {data.hours.map((h: any) => (
                    <div><dt>{h.days}</dt><dd>{h.open}–{h.close}</dd></div>
                  ))}
                </dl>
              </div>
            )}
          </aside>
        </div>

        {related.length > 0 && (
          <div>
            <div class="confluence-divider"><ConfluenceMark /></div>
            <p class="eyebrow">In the news</p>
            <ul class="stack" style="margin-top:0.75rem; list-style:none; padding:0;">
              {related.map((a) => (
                <li><a class="link" href={`/news/${a.id}/`}>{a.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
