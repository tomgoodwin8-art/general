---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectoryCard from '../../components/DirectoryCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CATEGORIES } from '../../data/site';
import { breadcrumbList } from '../../lib/schema';

const listings = (await getCollection('directory')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const count = listings.length;
const liveOffers = listings.filter((l) => l.data.offer && l.data.offer !== 'pending').length;

const crumbs = [
  { label: 'Home', path: '/' },
  { label: 'Directory', path: '/directory/' },
];
const schema = breadcrumbList(crumbs);
---
<BaseLayout
  title={`Brentford Business Directory | ${count} local businesses`}
  description={`The Brentford business directory: ${count} independent shops, restaurants and services in Brentford (TW8), with Brentford Card offers rolling out now.`}
  path="/directory/"
  schema={schema}
>
  <section class="section wrap">
    <Breadcrumb items={crumbs} />
    <p class="eyebrow" style="margin-top:1rem;">The Brentford Directory</p>
    <h1 class="page-title">The Brentford Directory: {count} local businesses</h1>
    <p class="lead">Independent shops, restaurants and services across Brentford, TW8. Card offers are being confirmed with each business — every listing will show its deal here. <a class="link" href="/card/">Get the card</a>.</p>

    <div class="chips" style="margin-top:2rem;">
      <a class="chip" href="/directory/" aria-current="page">All</a>
      {CATEGORIES.map((c) => (
        <a class="chip" href={`/directory/${c.slug}/`}>{c.name}</a>
      ))}
    </div>

    <div class="cards" style="margin-top:2.5rem;">
      {listings.map((entry, i) => <DirectoryCard entry={entry} seed={i} />)}
    </div>
  </section>
</BaseLayout>
