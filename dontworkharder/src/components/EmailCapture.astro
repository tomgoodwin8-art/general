---
import type { CaptureSource } from '../data/site';

interface Props {
  /** Tag written to the ESP so every signup is segmentable from day one. */
  source: CaptureSource;
  /** Which Kit form/automation to trigger. */
  list?: 'course' | 'launch';
  variant?: 'inline' | 'footer' | 'stacked';
  cta?: string;
  placeholder?: string;
  class?: string;
}

const {
  source,
  list = 'course',
  variant = 'inline',
  cta = 'Get the free 5-day course',
  placeholder = 'you@example.com',
  class: className = '',
} = Astro.props;

const id = `ec-${Math.random().toString(36).slice(2, 8)}`;
const isFooter = variant === 'footer';
const isStacked = variant === 'stacked';
---

<form
  class:list={['email-capture', `ec-${variant}`, className]}
  action="/api/subscribe"
  method="POST"
  data-email-capture
  novalidate
>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="list" value={list} />

  {/* Honeypot: humans never see or fill this (brief §7). */}
  <div class="hp" aria-hidden="true">
    <label for={`${id}-company`}>Company</label>
    <input id={`${id}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <div class:list={['fields', { stacked: isStacked }]}>
    <label class="sr-only" for={`${id}-email`}>Email address</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder={placeholder}
      class:list={['ec-input', { 'ec-input-light': isFooter }]}
    />
    <button type="submit" class:list={['btn', isFooter ? 'btn-outline-light' : 'btn-accent', 'ec-submit']}>
      <span class="label">{cta}</span>
    </button>
  </div>

  <p class="ec-message" role="status" aria-live="polite" hidden></p>
  <p class:list={['ec-fineprint', { light: isFooter }]}>
    No spam. One short lesson a day. Unsubscribe anytime.
  </p>
</form>

<style>
  .email-capture { width: 100%; }
  .fields {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
  }
  .fields.stacked { flex-direction: column; }
  .ec-input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.85rem 1rem;
    background: var(--color-paper);
    border: 1.5px solid var(--color-ink);
    border-radius: 3px;
    color: var(--color-ink);
  }
  .ec-input::placeholder { color: var(--color-ink-soft); opacity: 0.6; }
  .ec-input-light {
    background: transparent;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }
  .ec-input-light::placeholder { color: var(--color-paper); opacity: 0.55; }
  .ec-submit { white-space: nowrap; flex: 0 0 auto; }
  .fields.stacked .ec-submit { width: 100%; }

  .btn-outline-light {
    background: transparent;
    color: var(--color-paper);
    border: 1.5px solid var(--color-paper);
  }
  .btn-outline-light:hover { background: var(--color-paper); color: var(--color-ink); }

  .ec-fineprint {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-ink-soft);
  }
  .ec-fineprint.light { color: var(--color-paper); opacity: 0.7; }

  .ec-message {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .ec-message[data-state='error'] { color: var(--color-accent); }
  .ec-message[data-state='ok'] { color: var(--color-ink); }

  /* Honeypot kept out of view and out of the tab order. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 520px) {
    .fields:not(.stacked) { flex-direction: column; }
    .fields:not(.stacked) .ec-submit { width: 100%; }
  }
</style>

<script>
  // Progressive enhancement: forms work without JS (the Function 303-redirects
  // to /thanks). With JS we POST via fetch for inline errors and a clean redirect.
  document.querySelectorAll<HTMLFormElement>('form[data-email-capture]').forEach((form) => {
    const message = form.querySelector<HTMLParagraphElement>('.ec-message');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector<HTMLSpanElement>('.label');
    const labelText = label?.textContent ?? '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }

      setBusy(true);
      if (message) message.hidden = true;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          window.location.assign(json.redirect || '/thanks');
          return;
        }
        showError(json.error || 'Something went wrong. Please try again.');
      } catch {
        showError('Network error. Please try again.');
      } finally {
        setBusy(false);
      }
    });

    function setBusy(busy: boolean) {
      if (!button) return;
      button.disabled = busy;
      if (label) label.textContent = busy ? 'Sending…' : labelText;
    }
    function showError(text: string) {
      if (!message) return;
      message.textContent = text;
      message.dataset.state = 'error';
      message.hidden = false;
    }
  });
</script>
