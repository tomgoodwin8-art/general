---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="rule-bottom">
  <nav class="container-dwh flex items-center justify-between gap-6 py-5" aria-label="Primary">
    <a href="/" class="font-[var(--font-display)] text-xl tracking-tight" style="font-weight:520;">
      Don’t Work Harder
    </a>

    <button
      id="nav-toggle"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <ul
      id="nav-menu"
      class="hidden md:flex items-center gap-7 text-[0.98rem]"
    >
      {
        NAV.map((item) => {
          const active = path === item.href;
          if ('primary' in item && item.primary) {
            return (
              <li>
                <a href={item.href} class="btn btn-accent text-[0.95rem] py-2.5 px-5">
                  {item.label}
                </a>
              </li>
            );
          }
          return (
            <li>
              <a
                href={item.href}
                class:list={['hover:text-[var(--color-accent)] transition-colors', { 'text-[var(--color-accent)]': active }]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <ul id="nav-menu-mobile" class="hidden md:hidden container-dwh flex-col gap-1 pb-5">
    {
      NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block py-2 text-lg',
              'primary' in item && item.primary ? 'text-[var(--color-accent)] font-semibold' : '',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .rule-bottom { border-bottom: 1px solid var(--color-rule); }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-menu-mobile');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
    mobile?.classList.toggle('flex', open === false);
  });
</script>
