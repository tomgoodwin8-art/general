---
// Simple single-stroke line icons, one per toolkit slug. currentColor + no fill
// to match the editorial, minimal aesthetic. Sized by the consumer via CSS.
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  // megaphone
  marketing: '<path d="M4 9v6h3l6 4V5L7 9H4z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  // code brackets
  software: '<path d="M9 8l-4 4 4 4"/><path d="M15 8l4 4-4 4"/>',
  // trending up
  sales: '<path d="M3 17l6-6 4 4 8-8"/><path d="M16 7h5v5"/>',
  // lightbulb
  consulting: '<path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.3 1 2.5h6c0-1.2.4-1.9 1-2.5A6 6 0 0 0 12 3z"/>',
  // banknote
  'finance-accounting': '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9.5v5M18 9.5v5"/>',
  // headset
  'customer-support': '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="2.5" y="13" width="4" height="6" rx="1.5"/><rect x="17.5" y="13" width="4" height="6" rx="1.5"/><path d="M20 19a3 3 0 0 1-3 3h-3"/>',
  // rocket
  founders: '<path d="M12 3c3 1.5 5 4.5 5 8.5L15 16H9l-2-4.5C7 7.5 9 4.5 12 3z"/><circle cx="12" cy="9.5" r="1.5"/><path d="M9 16l-2 5M15 16l2 5"/>',
  // two people
  'hr-recruitment': '<circle cx="9" cy="8" r="3"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M17.5 14.2A5.5 5.5 0 0 1 20.5 19"/>',
  // package / cube
  product: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/>',
  // cog
  operations: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/>',
  // scales of justice
  law: '<path d="M12 3v18"/><path d="M5 7h14"/><path d="M8 21h8"/><path d="M5 7l-3 6a3 3 0 0 0 6 0z"/><path d="M19 7l-3 6a3 3 0 0 0 6 0z"/>',
  // pen
  'writing-content': '<path d="M4 20l1-4L16 5l3 3L8 19l-4 1z"/><path d="M14 7l3 3"/>',
  // clipboard check
  'project-management': '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M9 13l2 2 4-4"/>',
  // overlapping shapes
  design: '<rect x="3" y="3" width="10" height="10" rx="1"/><circle cx="15.5" cy="15.5" r="5.5"/>',
  // bar chart
  'data-analytics': '<path d="M3 21h18"/><rect x="5" y="11" width="3" height="7"/><rect x="10.5" y="7" width="3" height="11"/><rect x="16" y="13" width="3" height="5"/>',
  // graduation cap
  teaching: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.2V15c0 1.4 2.7 3 6 3s6-1.6 6-3v-3.8"/><path d="M22 9v5"/>',
  // calendar
  'admin-ea': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 3v4M16 3v4"/>',
  // house
  'real-estate': '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
};

const inner = icons[slug] ?? '<circle cx="12" cy="12" r="8"/>';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
