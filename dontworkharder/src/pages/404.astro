---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex={true}>
  <section class="section notfound">
    <div class="container-dwh">
      <div class="measure">
        <p class="eyebrow">404</p>
        <h1>That page wandered off.</h1>
        <p class="lede">
          The link is broken or the page has moved. No need to work harder looking
          for it. Try one of these instead.
        </p>
        <ul class="links">
          <li><a href="/" class="inline-link">Homepage</a></li>
          <li><a href="/method" class="inline-link">The method</a></li>
          <li><a href="/course" class="inline-link">The free course</a></li>
          <li><a href="/articles" class="inline-link">Articles</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound .lede { margin-top: 1.25rem; font-size: 1.15rem; color: var(--color-ink-soft); }
  .links { margin-top: 1.5rem; list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .inline-link { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
</style>
