---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaCourse from '../../components/CtaCourse.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;

const url = new URL(`/articles/${article.id}`, SITE.url).href;

const authorName = data.author?.name ?? SITE.author;
const authorNode = {
  '@type': 'Person',
  name: authorName,
  ...(data.author?.url && { url: data.author.url }),
  ...(data.author?.role && { jobTitle: data.author.role }),
  ...(data.author?.image && { image: new URL(data.author.image, SITE.url).href }),
  ...(data.author?.bio && { description: data.author.bio }),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  ...(data.keywords?.length && { keywords: data.keywords.join(', ') }),
  ...(data.category && { articleSection: data.category }),
  author: authorNode,
  publisher: { '@type': 'Organization', name: data.schema?.publisher ?? SITE.name },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL(SITE.ogImage, SITE.url).href,
};

// FAQPage schema for AEO when the article supplies an faq block (brief §9, EEAT).
const faqSchema = data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const schema = faqSchema ? [articleSchema, faqSchema] : articleSchema;

const dateStr = data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={data.title} description={data.description} type="article" schema={schema}>
  <article class="article">
    <header class="article-head section">
      <div class="container-dwh">
        <div class="measure">
          <p class="article-kicker"><a href="/articles">{data.category ?? 'Articles'}</a></p>
          <h1 class="article-title">{data.title}</h1>
          <p class="article-meta">{dateStr} · {data.readTime} min read</p>
        </div>
      </div>
    </header>

    <div class="container-dwh">
      <div class="prose-dwh article-body">
        <Content />
      </div>
    </div>
  </article>

  <!-- Every article ends with the same conversion block (brief §5.6) -->
  <div class="article-cta">
    <CtaCourse source="article" />
  </div>
</BaseLayout>

<style>
  .article-head { padding-bottom: 0; }
  .article-kicker { margin-bottom: 1rem; }
  .article-kicker a {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .article-title { margin-bottom: 1rem; }
  .article-meta { font-size: 0.9rem; color: var(--color-ink-soft); }
  .article-body { margin-inline: auto; padding-block: 2.5rem 4rem; }
  .article-cta { margin-top: 0; }
</style>
