---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaCourse from '../../components/CtaCourse.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Articles"
  description="Long-form writing on AI, the shorter working week, and reclaiming your time. The thinking behind Don’t Work Harder."
>
  <section class="section">
    <div class="container-dwh">
      <div class="measure index-head">
        <p class="eyebrow">Articles</p>
        <h1>The case, made in full.</h1>
        <p class="index-intro">
          Definitive pieces on why the time was taken, what the evidence actually
          shows, and how to get the hours back. Each one stands on its own. Together
          they are the argument behind the book.
        </p>
      </div>

      <div class="article-list">
        {
          articles.map((article) => (
            <ArticleCard
              href={`/articles/${article.id}`}
              title={article.data.title}
              excerpt={article.data.excerpt}
              readTime={article.data.readTime}
              date={article.data.pubDate}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaCourse source="article" />
</BaseLayout>

<style>
  .index-head h1 { margin-top: 0.4rem; }
  .index-intro { margin-top: 1rem; color: var(--color-ink-soft); }
  .article-list {
    margin-top: 3rem;
    border-bottom: 1px solid var(--color-rule);
    max-width: 48rem;
  }
</style>
