---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import FiveMoves from '../components/FiveMoves.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CtaCourse from '../components/CtaCourse.astro';
import { SITE } from '../data/site';
import heroImage from '../assets/dwh-pages-hero.png';
import bookCover from '../assets/dwh-front-cover.png';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout
  description="AI gave you the productivity. The hours stayed. Don’t Work Harder is a five-move method to reclaim the time, not spend it on more work. Start the free 5-day course."
  schema={websiteSchema}
>
  <!-- 1. Hero: the promise in one line, email field above the fold -->
  <section class="hero section">
    <div class="container-dwh">
      <div class="hero-grid">
        <div class="hero-inner">
          <p class="eyebrow">A book and a free course</p>
          <h1 class="hero-h1">The point of working less was never to work more.</h1>
          <p class="hero-sub">
            AI can finally hand back the hours a century of busywork took from you.
            This is the method for keeping them: five moves to reclaim your week
            and defend it. Begin with the free 5-day course.
          </p>
          <div class="hero-capture">
            <EmailCapture source="home-hero" list="course" cta="Get the free 5-day course" />
          </div>
        </div>
        <div class="hero-art">
          <Image
            src={heroImage}
            alt="The book Don’t Work Harder by Tom Goodwin, shown with sample pages and a free 5-day course badge."
            widths={[480, 760, 1040]}
            sizes="(max-width: 900px) 90vw, 44vw"
            loading="eager"
            class="hero-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The hook: name the reader's pain -->
  <section class="section rule-top hook">
    <div class="container-dwh">
      <div class="measure">
        <p class="hook-lede">
          You did everything right. You learned the tools, automated the busywork,
          answered faster than ever. The productivity arrived. The hours did not leave.
        </p>
        <p class="hook-body">
          Keynes told his grandchildren they would work fifteen hours a week by now.
          You work fifty. Every efficiency you have ever won was quietly reabsorbed
          into more output, more meetings, more scope. The problem was never that you
          worked too slowly. It is that nobody defended the time you saved. That is a
          skill, and it can be learned.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. The Five Moves: the most important visual on the site -->
  <section class="section rule-top moves-section">
    <div class="container-dwh">
      <div class="moves-head measure">
        <p class="eyebrow">The method</p>
        <h2>Five moves to work less, not more.</h2>
        <p class="moves-intro">
          The order matters. You cannot defend time you never found, and you should
          never automate work that should not exist in the first place.
        </p>
      </div>
      <div class="moves-list">
        <FiveMoves />
      </div>
    </div>
  </section>

  <!-- 4. Proof strip -->
  <div class="rule-top">
    <ProofStrip />
  </div>

  <!-- 5. The book teaser -->
  <section class="section rule-top book-teaser">
    <div class="container-dwh book-grid">
      <div class="book-cover-wrap">
        <Image
          src={bookCover}
          alt="Front cover of Don’t Work Harder by Tom Goodwin."
          widths={[224, 320, 448]}
          sizes="(max-width: 640px) 60vw, 14rem"
          class="book-cover-img"
        />
      </div>
      <div class="book-copy">
        <p class="eyebrow">The book</p>
        <h2>An anti-hustle argument, made carefully.</h2>
        <p>
          <em>Don’t Work Harder</em> makes the case that the fifteen-hour week is now
          a practical possibility rather than a utopian one, and then it gets specific
          about how to claim it. Three parts: the broken promise, the five moves, and
          how to actually live with the time once you have it back.
        </p>
        <p><a href="/book" class="link-accent">Read about the book <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  <!-- 6. Second email capture, different framing -->
  <CtaCourse source="home-second" heading="Start reclaiming your week." />
</BaseLayout>

<style>
  .hero { padding-block: clamp(3.5rem, 9vw, 7rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-inner { max-width: 38rem; }
  .hero-h1 { margin-top: 0.6rem; }
  .hero-sub {
    margin-top: 1.5rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 38rem;
  }
  .hero-capture { margin-top: 2.25rem; max-width: 34rem; }
  .hero-art { display: flex; justify-content: center; }
  .hero-img { width: 100%; height: auto; max-width: 32rem; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-img { max-width: 22rem; }
  }

  .hook-lede {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.25;
  }
  .hook-body { margin-top: 1.25rem; font-size: 1.15rem; color: var(--color-ink-soft); }

  .moves-head h2 { margin-top: 0.4rem; }
  .moves-intro { margin-top: 1rem; color: var(--color-ink-soft); }
  .moves-list { margin-top: 2.5rem; max-width: 46rem; }

  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 14rem) 1fr;
    gap: 3rem;
    align-items: center;
  }
  .book-copy h2 { margin-top: 0.4rem; }
  .book-copy p { margin-top: 1rem; color: var(--color-ink-soft); max-width: 36rem; }
  .book-cover-wrap { display: flex; }
  .book-cover-img {
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 18px 40px -18px rgba(22, 19, 15, 0.35);
  }
  .link-accent { color: var(--color-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 640px) {
    .book-grid { grid-template-columns: 1fr; gap: 2rem; }
    .book-cover-wrap { max-width: 12rem; }
  }
</style>
