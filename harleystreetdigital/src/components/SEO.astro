---
const SITE_URL = "https://harleystreetdigital.com";
const SITE_NAME = "Harley Street Digital";

interface Props {
  title: string;
  description: string;
  /** Path-relative canonical, e.g. "/directory". Defaults to current. */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = "/images/og-default.png",
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | ${SITE_NAME}`;
const canonicalPath = path ?? Astro.url.pathname;
const canonical =
  new URL(canonicalPath, SITE_URL).href.replace(/\/$/, "") || SITE_URL;
const ogUrl = new URL(ogImage, SITE_URL).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="theme-color" content="#14213d" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
