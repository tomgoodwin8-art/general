{
  "name": "lphg-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-catalog.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test",
    "lint:schema": "node scripts/schema-lint.mjs",
    "lint:links": "node scripts/link-check.mjs",
    "verify": "npm run build && npm run lint:schema && npm run lint:links && npm test",
    "deploy": "astro build && wrangler pages deploy dist --project-name lphg"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.7.0",
    "wrangler": "^4"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.0.0"
  }
