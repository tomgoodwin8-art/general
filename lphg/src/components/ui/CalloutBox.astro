---
interface Props {
  variant?: 'info' | 'warning' | 'price';
  title?: string;
}
const { variant = 'info', title } = Astro.props;
const styles = {
  info: 'border-brand-primary-400 bg-brand-primary/5',
  warning: 'border-amber-500 bg-amber-50',
  price: 'border-brand-accent bg-brand-accent/5',
};
const defaultTitle = { info: undefined, warning: 'Important', price: 'Our price' };
const shown = title ?? defaultTitle[variant];
---

<aside class:list={['my-6 rounded-card border-l-4 p-4', styles[variant]]} role="note">
  {shown && <p class="mb-1 font-display text-sm font-semibold uppercase tracking-wide text-brand-ink">{shown}</p>}
  <div class="text-sm leading-relaxed text-brand-ink"><slot /></div>
</aside>
