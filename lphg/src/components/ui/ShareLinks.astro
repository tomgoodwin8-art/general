---
// Share links (X, Facebook, LinkedIn, WhatsApp), brief §8.4. No JS, no trackers.
import { site } from '../../data/site';
interface Props {
  path: string;
  title: string;
}
const { path, title } = Astro.props;
const url = encodeURIComponent(site.url.replace(/\/$/, '') + path);
const text = encodeURIComponent(title);
const links = [
  { label: 'Share on X', short: 'X', href: `https://twitter.com/intent/tweet?url=${url}&text=${text}` },
  { label: 'Share on Facebook', short: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${url}` },
  { label: 'Share on LinkedIn', short: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}` },
  { label: 'Share on WhatsApp', short: 'WhatsApp', href: `https://wa.me/?text=${text}%20${url}` },
];
---

<div class="flex flex-wrap items-center gap-2 text-xs">
  <span class="text-brand-muted">Share</span>
  {
    links.map((l) => (
      <a
        href={l.href}
        rel="noopener nofollow"
        target="_blank"
        aria-label={l.label}
        class="rounded-full border border-brand-line px-3 py-1 font-medium text-brand-primary hover:bg-brand-surface"
      >
        {l.short}
      </a>
    ))
  }
</div>
