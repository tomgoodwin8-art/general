---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | LPHG" description="The page you were looking for could not be found." canonical="/404/" noindex={true}>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-display text-5xl font-semibold text-brand-primary">404</p>
    <h1 class="mt-4 text-2xl">We couldn't find that page</h1>
    <p class="mt-3 text-brand-muted">It may have moved. Try our centres, prices or book an appointment.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/centres/" class="rounded-full border border-brand-primary px-5 py-2.5 text-sm font-semibold text-brand-primary">Browse centres</a>
      <a href="/prices/" class="rounded-full border border-brand-primary px-5 py-2.5 text-sm font-semibold text-brand-primary">Price list</a>
      <a href="/book/" class="rounded-full bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white">Book</a>
    </div>
  </div>
</Base>
