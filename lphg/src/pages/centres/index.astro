---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import TrustBar from '../../components/ui/TrustBar.astro';
import { priceFrom } from '../../lib/format';
import { graph, organisationSchema, breadcrumbSchema } from '../../lib/schema';

const centres = (await getCollection('centres')).sort((a, b) => a.data.order - b.data.order);
const trail = [
  { name: 'Home', url: '/' },
  { name: 'Centres', url: '/centres/' },
];
const jsonLd = graph(organisationSchema(), breadcrumbSchema(trail));
---

<Base
  title="Our Centres | Private Scans & Consultations | LPHG"
  description="Specialist centres at 11 Devonshire Place — women's health, men's health, MSK, heart, imaging, pregnancy and weight management. No GP referral needed."
  canonical="/centres/"
  jsonLd={jsonLd}
>
  <section data-hero class="border-b border-brand-line bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <Breadcrumb {trail} emitSchema={false} />
      <h1 class="mt-4 text-3xl md:text-4xl">Specialist centres</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-muted">
        Consultant-led diagnostics and assessments, most within the week. Choose a centre to see
        every scan, test and price.
      </p>
    </div>
  </section>

  <div class="border-b border-brand-line bg-white py-4"><TrustBar /></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        centres.map((c) => (
          <a
            href={`/centres/${c.id}/`}
            class="flex flex-col rounded-card border border-brand-line bg-white p-6 transition-shadow hover:shadow-md"
          >
            <h2 class="font-display text-xl font-semibold text-brand-ink">{c.data.title}</h2>
            <p class="mt-2 flex-1 text-sm text-brand-muted">{c.data.promise}</p>
            <p class="mt-4 text-sm font-semibold text-brand-primary">{priceFrom(c.data.priceFrom)} →</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
