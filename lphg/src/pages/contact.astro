---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { site } from '../data/site';
import { graph, organisationSchema, breadcrumbSchema } from '../lib/schema';
const trail = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }];
const jsonLd = graph(organisationSchema(), breadcrumbSchema(trail));
const tel = site.phone.replace(/\s/g, '');
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.locality}, ${site.address.region} ${site.address.postalCode}`);
---
<Base
  title="Contact & Find Us | LPHG"
  description="Contact London Private Healthcare Group at 11 Devonshire Place, London W1. Call, email or book online. Same-week appointments, no GP referral."
  canonical="/contact/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumb {trail} emitSchema={false} />
    <h1 class="mt-4 text-3xl md:text-4xl">Contact us</h1>
    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xl">Get in touch</h2>
        <address class="mt-3 not-italic text-brand-ink">
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </address>
        <p class="mt-4"><a href={`tel:${tel}`} data-analytics="call_click" class="font-semibold text-brand-primary underline">{site.phoneDisplay}</a></p>
        <p class="mt-1"><a href={`mailto:${site.email}`} class="text-brand-primary underline">{site.email}</a></p>
        <p class="mt-4 text-sm text-brand-muted">Opening hours: Mon–Fri 08:00–20:00, Sat 09:00–17:00.</p>
        <a href="/book/" class="mt-6 inline-block rounded-full bg-brand-primary px-6 py-3 text-sm font-semibold text-white">Book online</a>
      </div>
      <div>
        <h2 class="text-xl">Find us</h2>
        <p class="mt-3 text-sm text-brand-muted">
          We are in the Harley Street Medical District, a short walk from Regent's Park and Baker
          Street Underground stations.
        </p>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 rounded-card border border-brand-line bg-brand-surface px-4 py-3 text-sm font-medium text-brand-primary hover:border-brand-primary"
        >
          Open in Google Maps →
        </a>
      </div>
    </div>
  </div>
</Base>
