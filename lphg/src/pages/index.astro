---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TrustBar from '../components/ui/TrustBar.astro';
import PackageCard from '../components/ui/PackageCard.astro';
import StepTimeline from '../components/ui/StepTimeline.astro';
import ReviewStrip from '../components/ui/ReviewStrip.astro';
import BookCTA from '../components/ui/BookCTA.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import { site } from '../data/site';
import { sumIncludes, priceFrom } from '../lib/format';
import { graph, organisationSchema } from '../lib/schema';

const centres = (await getCollection('centres')).sort((a, b) => a.data.order - b.data.order);
const packages = (await getCollection('packages')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const jsonLd = graph(organisationSchema());

const steps = [
  { label: 'Book online', detail: 'Pick a scan, test or consultation and a time. No GP referral needed.' },
  { label: 'Same-week visit', detail: `See us at ${site.address.street}, ${site.address.region} W1.` },
  { label: 'Report in 24 hours', detail: 'A written report is issued within 24 hours, with onward referral if you need it.' },
];
---

<Base
  title="London Private Healthcare Group | Scans & Tests, W1"
  description="Private scans, tests and consultant appointments at 11 Devonshire Place, W1. Every price published, no GP referral, report within 24 hours."
  canonical="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section data-hero class="border-b border-brand-line bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-accent-600">{site.strapline}</p>
      <h1 class="mt-3 max-w-3xl text-4xl md:text-5xl">Private diagnostics and specialist care, with every price published.</h1>
      <p class="mt-5 max-w-2xl text-lg text-brand-muted">
        Same-week scans, tests and consultant appointments in the Harley Street Medical District.
        No GP referral needed. A written report within 24 hours.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <BookCTA label="Book an appointment" />
        <a href="/prices/" class="text-sm font-semibold text-brand-primary underline underline-offset-2">See all prices</a>
      </div>
    </div>
  </section>

  <div class="border-y border-brand-line bg-white py-4"><TrustBar /></div>

  <!-- Centres -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="centres-heading">
    <div class="flex items-end justify-between">
      <h2 id="centres-heading" class="text-3xl">Specialist centres</h2>
      <a href="/centres/" class="text-sm font-semibold text-brand-primary hover:underline">All centres →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        centres.map((c) => (
          <a href={`/centres/${c.id}/`} class="flex flex-col rounded-card border border-brand-line bg-white p-6 transition-shadow hover:shadow-md">
            <h3 class="font-display text-lg font-semibold text-brand-ink">{c.data.title}</h3>
            <p class="mt-2 flex-1 text-sm text-brand-muted">{c.data.promise}</p>
            <p class="mt-4 text-sm font-semibold text-brand-primary">{priceFrom(c.data.priceFrom)} →</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Packages -->
  <section class="bg-brand-surface py-16" aria-labelledby="packages-heading">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex items-end justify-between">
        <h2 id="packages-heading" class="text-3xl">One-stop packages</h2>
        <a href="/packages/" class="text-sm font-semibold text-brand-primary hover:underline">All packages →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          packages.map((p) => (
            <PackageCard title={p.data.title} slug={p.id} promise={p.data.promise} price={p.data.price} struck={sumIncludes(p.data.includes)} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-3xl">How it works</h2>
    <div class="mt-8 max-w-2xl"><StepTimeline steps={steps} /></div>
    <div class="mt-8"><ReviewStrip /></div>
  </section>

  <!-- Final CTA -->
  <section class="bg-brand-primary py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-3xl text-white">Book with a clinic that publishes its prices</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-surface/80">
        Same-day appointments often available. Report within 24 hours. No GP referral needed.
      </p>
      <div class="mt-8 flex justify-center"><BookCTA label="Book an appointment" /></div>
    </div>
  </section>

  <StickyMobileCTA slot="sticky" />
</Base>
