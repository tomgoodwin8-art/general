---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import TrustBar from '../../components/ui/TrustBar.astro';
import PackageCard from '../../components/ui/PackageCard.astro';
import { sumIncludes } from '../../lib/format';
import { graph, organisationSchema, breadcrumbSchema } from '../../lib/schema';

const packages = (await getCollection('packages')).sort((a, b) => a.data.order - b.data.order);
const trail = [
  { name: 'Home', url: '/' },
  { name: 'Packages', url: '/packages/' },
];
const jsonLd = graph(organisationSchema(), breadcrumbSchema(trail));
---

<Base
  title="One-Stop Health Packages | Fixed Prices | LPHG"
  description="All-inclusive health packages — consult, scan and plan in a single visit. Fixed, published prices from £295. No GP referral needed."
  canonical="/packages/"
  jsonLd={jsonLd}
>
  <section data-hero class="border-b border-brand-line bg-brand-surface">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <Breadcrumb {trail} emitSchema={false} />
      <h1 class="mt-4 text-3xl md:text-4xl">One-stop packages</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-muted">
        Consultation, scan and management plan bundled into a single visit, at a fixed
        all-inclusive price. Every inclusion is itemised on the page.
      </p>
    </div>
  </section>

  <div class="border-b border-brand-line bg-white py-4"><TrustBar /></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        packages.map((p) => (
          <PackageCard
            title={p.data.title}
            slug={p.id}
            promise={p.data.promise}
            price={p.data.price}
            struck={sumIncludes(p.data.includes)}
          />
        ))
      }
    </div>
  </div>
</Base>
