---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import TrustBar from '../../components/ui/TrustBar.astro';
import { gbp } from '../../lib/format';
import { graph, organisationSchema, breadcrumbSchema } from '../../lib/schema';

const centres = (await getCollection('centres')).sort((a, b) => a.data.order - b.data.order);
const centreTitle = new Map(centres.map((c) => [c.id, c.data.title]));

const services = (await getCollection('services')).sort(
  (a, b) => a.data.centre.id.localeCompare(b.data.centre.id) || a.data.price - b.data.price
);
const packages = (await getCollection('packages')).sort((a, b) => a.data.order - b.data.order);

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Prices', url: '/prices/' },
];
const jsonLd = graph(organisationSchema(), breadcrumbSchema(trail));
---

<Base
  title="Price List | Transparent, All-Inclusive | LPHG"
  description="Every scan, test, consultation and package price in one list. All-inclusive, no hidden fees, no GP referral needed. Marylebone, London W1."
  canonical="/prices/"
  jsonLd={jsonLd}
>
  <section data-hero class="border-b border-brand-line bg-brand-surface">
    <div class="mx-auto max-w-4xl px-4 py-10">
      <Breadcrumb {trail} emitSchema={false} />
      <h1 class="mt-4 text-3xl md:text-4xl">Price list</h1>
      <p class="mt-3 max-w-2xl text-lg text-brand-muted">
        Every price is all-inclusive: the scan or consultation, the specialist's time, and your
        written report within 24 hours. No referral, no hidden fees.
      </p>
    </div>
  </section>

  <div class="border-b border-brand-line bg-white py-4"><TrustBar /></div>

  <div class="mx-auto max-w-4xl px-4 py-10">
    <label class="block text-sm font-medium">
      Filter by centre
      <select
        id="centre-filter"
        class="mt-1 block w-full max-w-xs rounded-md border border-brand-line bg-white px-3 py-2 text-sm"
      >
        <option value="all">All centres</option>
        {centres.map((c) => <option value={c.id}>{c.data.title}</option>)}
        <option value="packages">Packages</option>
      </select>
    </label>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <caption class="sr-only">LPHG price list</caption>
        <thead>
          <tr class="border-b-2 border-brand-line text-xs uppercase tracking-wide text-brand-muted">
            <th scope="col" class="py-3 pr-4">Service</th>
            <th scope="col" class="py-3 pr-4">Centre</th>
            <th scope="col" class="py-3 pr-4 text-right">Price</th>
            <th scope="col" class="py-3 text-right"><span class="sr-only">Book</span></th>
          </tr>
        </thead>
        <tbody id="price-rows">
          {
            services.map((s) => (
              <tr class="price-row border-b border-brand-line/70" data-centre={s.data.centre.id}>
                <td class="py-3 pr-4">
                  <a href={`/services/${s.id}/`} class="font-medium text-brand-primary hover:underline">
                    {s.data.title}
                  </a>
                </td>
                <td class="py-3 pr-4 text-brand-muted">{centreTitle.get(s.data.centre.id)}</td>
                <td class="py-3 pr-4 text-right font-semibold">{gbp(s.data.price)}</td>
                <td class="py-3 text-right">
                  <a href={`/book/?service=${encodeURIComponent(s.data.sembleBookingTypeId)}`} class="text-xs font-semibold text-brand-accent-600 hover:underline">Book</a>
                </td>
              </tr>
            ))
          }
          {
            packages.map((p) => (
              <tr class="price-row border-b border-brand-line/70" data-centre="packages">
                <td class="py-3 pr-4">
                  <a href={`/packages/${p.id}/`} class="font-medium text-brand-primary hover:underline">
                    {p.data.title} <span class="text-xs text-brand-accent-600">package</span>
                  </a>
                </td>
                <td class="py-3 pr-4 text-brand-muted">Package</td>
                <td class="py-3 pr-4 text-right font-semibold">{gbp(p.data.price)}</td>
                <td class="py-3 text-right">
                  <a href={`/book/?service=${encodeURIComponent(p.data.sembleBookingTypeId)}`} class="text-xs font-semibold text-brand-accent-600 hover:underline">Book</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    (() => {
      const select = document.getElementById('centre-filter');
      const rows = document.querySelectorAll('.price-row');
      select?.addEventListener('change', () => {
        const v = select.value;
        rows.forEach((r) => {
          r.style.display = v === 'all' || r.getAttribute('data-centre') === v ? '' : 'none';
        });
      });
    })();
  </script>
</Base>
