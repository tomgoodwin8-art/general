---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import BookCTA from '../../components/ui/BookCTA.astro';
import { graph, organisationSchema, breadcrumbSchema, physicianSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const specialists = await getCollection('specialists');
  return specialists.map((specialist) => ({ params: { slug: specialist.id }, props: { specialist } }));
}

const { specialist } = Astro.props;
const d = specialist.data;
const { Content } = await render(specialist);

const centres = (await Promise.all(d.centres.map((r) => getEntry(r)))).filter(Boolean);

const path = `/specialists/${specialist.id}/`;
const trail = [
  { name: 'Home', url: '/' },
  { name: 'Specialists', url: '/specialists/' },
  { name: d.name, url: path },
];

const jsonLd = graph(
  organisationSchema(),
  breadcrumbSchema(trail),
  physicianSchema({
    name: d.name,
    role: d.role,
    url: path,
    credentials: d.credentials,
    sameAs: d.profileExternal ? [d.profileExternal] : undefined,
  })
);
---

<Base title={d.metaTitle} description={d.metaDescription} canonical={path} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumb {trail} emitSchema={false} />
    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center">
      {
        d.image && (
          <img src={d.image} alt={d.imageAlt ?? d.name} width="96" height="96" class="h-24 w-24 rounded-full object-cover" />
        )
      }
      <div>
        <h1 class="text-3xl">{d.name}</h1>
        <p class="mt-1 text-brand-muted">{d.role}</p>
        {d.credentials.length > 0 && <p class="text-sm text-brand-muted">{d.credentials.join(', ')}</p>}
        {d.gmcNumber && <p class="text-sm text-brand-muted">GMC {d.gmcNumber}</p>}
      </div>
    </div>

    {
      d.specialties.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl">Areas of focus</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {d.specialties.map((s) => (
              <li class="rounded-full bg-brand-surface px-3 py-1 text-sm text-brand-ink">{s}</li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose-lphg mt-8"><Content /></div>

    {
      centres.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl">Centres</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {centres.map((c) => (
              <li>
                <a href={`/centres/${c!.id}/`} class="rounded-full border border-brand-line px-3 py-1 text-sm text-brand-primary hover:border-brand-primary">
                  {c!.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-10"><BookCTA label="Book an appointment" /></div>
  </div>
</Base>
