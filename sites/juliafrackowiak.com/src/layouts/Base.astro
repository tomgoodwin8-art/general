---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Julia Frackowiak',
  givenName: 'Julia',
  familyName: 'Frackowiak',
  nationality: 'United Kingdom',
  jobTitle: 'Track and Field Athlete',
  description:
    'Under-16 track and field athlete competing for Thames Valley Harriers, registered with England Athletics.',
  memberOf: { '@type': 'SportsTeam', name: 'Thames Valley Harriers' },
  url: 'https://juliafrackowiak.com/',
  image: 'https://juliafrackowiak.com/images/julia-frackowiak.jpg',
  sameAs: ['https://data.opentrack.run/a/27f4d59c-9c76-405c-932f-be46c493d91a/'],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>Julia Frackowiak — U16 Athlete, Thames Valley Harriers</title>
    <meta
      name="description"
      content="Julia Frackowiak, Under-16 track and field athlete for Thames Valley Harriers, registered with England Athletics."
    />
    <link rel="canonical" href="https://juliafrackowiak.com/" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Julia Frackowiak" />
    <meta property="og:description" content="U16 track and field athlete, Thames Valley Harriers." />
    <meta property="og:url" content="https://juliafrackowiak.com/" />
    <meta property="og:image" content="https://juliafrackowiak.com/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FAFAF8" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }
</script>
