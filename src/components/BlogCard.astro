---
interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
}
const { title, description, href, pubDate } = Astro.props;
const dateStr = pubDate.toLocaleDateString("en-GB", {
  day: "numeric", month: "short", year: "numeric",
});
---
<a href={href} class="group block py-6 border-b border-grey-100 hover:border-powder-deep transition-colors">
  <time datetime={pubDate.toISOString()} class="text-grey-400 text-sm" style="color:#9ca3af">{dateStr}</time>
  <h3 class="mt-2 display font-medium group-hover:text-powder-deep transition-colors">{title}</h3>
  <p class="mt-2 text-grey-400 max-w-2xl" style="color:#4b5563">{description}</p>
</a>
