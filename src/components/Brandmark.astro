---
/**
 * Brandmark — site logo lockup: TG monogram (favicon) + divider + name/location.
 * "Tom Goodwin" over "London" (London in powder/blue).
 * `variant`: "light" for pale backgrounds (header), "dark" for ink (footer).
 */
interface Props { variant?: "light" | "dark"; class?: string; }
const { variant = "light", class: className = "" } = Astro.props;
const dark = variant === "dark";
const src = dark ? "/favicon-reversed.svg" : "/favicon.svg";
---
<span class:list={["inline-flex items-center gap-3", className]}>
  <img src={src} alt="" aria-hidden="true" width="40" height="40" class="h-9 w-9 shrink-0 rounded-[3px]" />
  <span class:list={["h-9 w-px shrink-0", dark ? "bg-white/25" : "bg-grey-400/50"]} aria-hidden="true"></span>
  <span class="flex flex-col leading-none">
    <span class:list={["display font-bold tracking-tight text-[1.05rem]", dark ? "text-paper" : "text-ink"]}>Tom Goodwin</span>
    <span class:list={["display font-medium text-sm mt-1", dark ? "text-powder" : "text-powder-deep"]}>London</span>
  </span>
</span>
