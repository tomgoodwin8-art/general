---
interface Props {
  heading: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
}
const {
  heading,
  body,
  primaryLabel = "Send a brief",
  primaryHref = "/contact",
} = Astro.props;
---
<section class="bg-ink text-paper py-20">
  <div class="container-tg text-center max-w-2xl mx-auto">
    <h2 class="mb-5">{heading}</h2>
    {body && <p class="text-grey-400 mb-9" style="color:#cbd5e1">{body}</p>}
    <div class="flex flex-wrap gap-4 justify-center">
      <a href={primaryHref} class="btn btn-ink !bg-paper !text-ink hover:!bg-powder">{primaryLabel} →</a>
      <a href="https://www.cal.eu/tom-goodwin-wpxjme" class="btn btn-powder !text-paper !border-powder hover:!text-ink">Book a call</a>
    </div>
  </div>
</section>
