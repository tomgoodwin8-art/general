---
interface Props {
  title: string;
  client: string;
  result: string;
  description: string;
  href: string;
  sector?: string;
  quote?: string;
  quoteAuthor?: string;
}
const { title, client, result, description, href, sector, quote, quoteAuthor } = Astro.props;
---
<a href={href} class="group flex flex-col bg-paper border border-grey-100 p-7 hover:border-powder-deep transition-colors">
  <div class="flex items-center justify-between gap-3">
    <span class="eyebrow">{client}</span>
    {sector && <span class="text-grey-400 text-xs" style="color:#9ca3af">{sector}</span>}
  </div>
  <p class="display text-3xl font-bold text-powder-deep mt-4 leading-none">{result}</p>
  <h3 class="mt-3 display font-medium group-hover:text-powder-deep transition-colors">{title}</h3>
  <p class="mt-2 text-sm text-grey-400" style="color:#4b5563">{description}</p>

  {quote && (
    <figure class="mt-5 pt-5 border-t border-grey-100">
      <blockquote class="text-sm italic" style="color:#1f2937">"{quote}"</blockquote>
      {quoteAuthor && <figcaption class="mt-2 text-xs display font-medium" style="color:#6b7280">{quoteAuthor}</figcaption>}
    </figure>
  )}
</a>
