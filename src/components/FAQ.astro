---
/**
 * FAQ — answer-first accordion that also emits FAQPage JSON-LD (§9, §10.1).
 * Pass the same `items` used for display; schema is generated from them.
 */
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = "Frequently asked questions" } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<section class="container-tg py-16 md:py-20" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="mb-8">{heading}</h2>
  <div class="max-w-3xl divide-y divide-grey-100 border-t border-grey-100">
    {items.map((item) => (
      <details class="group py-4">
        <summary class="flex justify-between items-center gap-4 cursor-pointer list-none font-display font-medium text-lg">
          <span>{item.q}</span>
          <span class="text-powder-deep transition-transform group-open:rotate-45 text-2xl leading-none" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-grey-400 max-w-prose" style="color:#374151">{item.a}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
