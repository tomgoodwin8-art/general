---
import { navOffers, mainNav, profile, ENTITY, socials } from "../data/profile";
import Brandmark from "./Brandmark.astro";
const year = new Date().getFullYear();

// Inline brand icons, keyed by social label.
const socialIcons: Record<string, string> = {
  LinkedIn:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z",
  YouTube:
    "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
};
---

<footer class="bg-ink text-paper mt-24">
  <div class="container-tg py-16">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href="/" aria-label="Tom Goodwin, London — home">
          <Brandmark variant="dark" />
        </a>
        <p class="mt-5 text-grey-400 text-sm max-w-xs">{ENTITY}</p>
        <p class="mt-2 text-grey-400 text-sm">London, UK</p>
        <ul class="mt-5 flex gap-4">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel="me noopener"
                target="_blank"
                aria-label={s.label}
                class="text-grey-400 hover:text-paper transition-colors"
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
                  <path d={socialIcons[s.label]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Offers">
        <h2 class="eyebrow !text-powder mb-4">Work with me</h2>
        <ul class="space-y-2 text-sm">
          {navOffers.map((o) => (
            <li><a href={o.slug} class="text-grey-400 hover:text-paper transition-colors">{o.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site">
        <h2 class="eyebrow !text-powder mb-4">Site</h2>
        <ul class="space-y-2 text-sm">
          {mainNav.filter((n) => n.href !== "/work-with-me").map((item) => (
            <li><a href={item.href} class="text-grey-400 hover:text-paper transition-colors">{item.label}</a></li>
          ))}
          <li><a href="/now" class="text-grey-400 hover:text-paper transition-colors">Now</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow !text-powder mb-4">Direct</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={`mailto:${profile.email}`} class="text-grey-400 hover:text-paper transition-colors">{profile.email}</a></li>
          <li><a href={`mailto:${profile.pressEmail}`} class="text-grey-400 hover:text-paper transition-colors">{profile.pressEmail}</a></li>
          <li><a href="https://www.linkedin.com/in/thomasgoodwin/" class="text-grey-400 hover:text-paper transition-colors" rel="me">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-4 text-sm text-grey-400">
      <p>&copy; {year} {profile.legalEntity} t/a GAMEPLAN.</p>
      <p>
        <a href="/llms.txt" class="hover:text-paper">llms.txt</a>
        <span class="mx-2">·</span>
        <a href="/rss.xml" class="hover:text-paper">RSS</a>
      </p>
    </div>
  </div>
</footer>
