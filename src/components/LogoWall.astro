---
import { logoWall } from "../data/profile";
/**
 * Logo wall (§4.2). Dark section. White brand marks (white-on-transparent
 * PNGs) on the ink background.
 */
---
<section class="bg-ink text-paper py-16 md:py-20" aria-labelledby="logos-heading">
  <div class="container-tg">
    <h2 id="logos-heading" class="sr-only">Brands and organisations Tom has worked with</h2>
    <ul class="grid grid-cols-3 md:grid-cols-6 lg:grid-cols-7 gap-px bg-white/10">
      {logoWall.map((logo) => (
        <li class="bg-ink flex items-center justify-center px-4 py-7 opacity-90 hover:opacity-100 transition-opacity">
          <img
            src={logo.src}
            alt={logo.name}
            loading="lazy"
            class="max-h-8 w-auto object-contain"
          />
        </li>
      ))}
    </ul>
    <p class="text-grey-400 text-sm mt-6">Work delivered across agency, in-house and consultancy roles.</p>
  </div>
</section>
