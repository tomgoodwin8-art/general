---
interface Props {
  title: string;
  slug: string;
  summary: string;
  index?: number;
}
const { title, slug, summary, index } = Astro.props;
---
<a href={slug} class="group block bg-paper border border-grey-100 p-7 hover:border-powder-deep transition-colors">
  {index !== undefined && (
    <span class="eyebrow !text-grey-400">{String(index + 1).padStart(2, "0")}</span>
  )}
  <h3 class="mt-2 display font-medium group-hover:text-powder-deep transition-colors">{title}</h3>
  <p class="mt-3 text-grey-400" style="color:#4b5563">{summary}</p>
  <span class="mt-5 inline-block text-powder-deep font-medium text-sm">Read more →</span>
</a>
