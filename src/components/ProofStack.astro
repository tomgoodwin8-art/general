---
import { proofStack } from "../data/profile";
---
<section class="container-tg py-16 md:py-24" aria-labelledby="proof-heading">
  <p class="eyebrow mb-3">The proof stack</p>
  <h2 id="proof-heading" class="max-w-2xl mb-12">Evidence, not adjectives.</h2>
  <ol class="grid gap-px bg-grey-100 border border-grey-100 md:grid-cols-2 lg:grid-cols-3">
    {proofStack.map((p, i) => (
      <li class="bg-paper p-8 flex flex-col">
        <span class="eyebrow !text-grey-400 mb-4">{String(i + 1).padStart(2, "0")}</span>
        <span class="display text-4xl md:text-5xl font-bold text-powder-deep leading-none">{p.stat}</span>
        <span class="display text-lg font-medium mt-2">{p.label}</span>
        <span class="text-grey-400 text-sm mt-3" style="color:#6b7280">{p.detail}</span>
      </li>
    ))}
  </ol>
</section>
