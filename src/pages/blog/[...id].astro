---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";
import { SITE_URL, ENTITY, profile } from "../../data/profile";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const dateStr = post.data.pubDate.toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});

const articleNode = {
  "@type": "Article",
  "@id": `${SITE_URL}${path}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { "@id": `${SITE_URL}/#person` },
  publisher: { "@id": `${SITE_URL}/#gameplan` },
  mainEntityOfPage: new URL(path, SITE_URL).href,
  about: post.data.targetQuery,
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  {path}
  type="article"
  schemaNodes={[articleNode]}
>
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog" },
    { label: post.data.title, href: path },
  ]} />

  <article class="container-tg py-10 md:py-14">
    <header class="max-w-3xl mb-10">
      <time datetime={post.data.pubDate.toISOString()} class="eyebrow">{dateStr}</time>
      <h1 class="mt-3 text-balance">{post.data.title}</h1>
      <p class="mt-4 text-grey-400 text-sm" style="color:#6b7280">By {ENTITY}</p>
    </header>
    <div class="prose-tg">
      <Content />
    </div>
  </article>

  {post.data.faqs.length > 0 && <FAQ items={post.data.faqs} heading="Questions" />}

  <CTASection
    heading="Want this applied to your business?"
    body="Send a brief and I'll tell you how it maps to your situation."
  />
</BaseLayout>
