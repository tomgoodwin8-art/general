---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import CTASection from "../../components/CTASection.astro";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title="Case studies"
  description="Selected work from Tom Goodwin, Founder of GAMEPLAN.: a 13-market Gucci pitch won, an agency acquisition negotiated, 60% YoY Google Ads growth."
  path="/case-studies"
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Case studies", href: "/case-studies" }]} />
  <PageHeader
    eyebrow="Selected work"
    title="The work, with the receipts."
    lead="A sample of engagements across performance, pitching and agency M&A. Numbers first, anonymised where confidentiality requires."
  />
  <section class="container-tg pb-16">
    <div class="grid gap-6 md:grid-cols-3">
      {caseStudies.map((cs) => (
        <CaseStudyCard
          title={cs.data.title}
          client={cs.data.client}
          result={cs.data.result}
          description={cs.data.description}
          sector={cs.data.sector}
          href={`/case-studies/${cs.id}`}
        />
      ))}
    </div>
  </section>
  <CTASection heading="Want results like these?" body="Send a brief with your situation and budget band." />
</BaseLayout>
