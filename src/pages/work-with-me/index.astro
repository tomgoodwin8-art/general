---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import OfferCard from "../../components/OfferCard.astro";
import CTASection from "../../components/CTASection.astro";
import { navOffers } from "../../data/profile";
---
<BaseLayout
  title="Work with me"
  description="Four ways to work with Tom Goodwin, Founder of GAMEPLAN.: fractional performance leadership, AI marketing operations, AI search and AEO, and paid media strategy."
  path="/work-with-me"
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Work with me", href: "/work-with-me" }]} />
  <PageHeader
    eyebrow="Work with me"
    title="Four ways to put me to work."
    lead="Senior performance and AI work, delivered directly. Pick the shape that fits, or send a brief and I'll tell you honestly which one does."
  />
  <section class="container-tg pb-16">
    <div class="grid gap-6 md:grid-cols-2">
      {navOffers.map((o, i) => (
        <OfferCard title={o.title} slug={o.slug} summary={o.summary} index={i} />
      ))}
    </div>
    <p class="mt-8 text-grey-400 text-sm max-w-2xl" style="color:#6b7280">
      Looking for pitch consulting or help selling an agency? I do that too, by referral and direct enquiry. <a href="/contact" class="underline text-powder-deep">Get in touch</a>.
    </p>
  </section>
  <CTASection
    heading="Not sure which fits?"
    body="Send a brief with your situation and budget band. I'll point you to the right engagement, even if it isn't with me."
  />
</BaseLayout>
