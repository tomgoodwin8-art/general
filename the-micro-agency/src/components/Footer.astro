---
/**
 * Footer.astro (§4 footer grid) — Services / Company / Resources / Governance,
 * social, Elite Partner badge, London office line, copyright, llms.txt + RSS.
 */
import { AGENCY, socials } from "../data/site";
import Wordmark from "./Wordmark.astro";
import PartnerBadge from "./PartnerBadge.astro";

const cols = [
  {
    title: "Services",
    links: [
      { label: "Managed Microsoft Ads", href: "/services" },
      { label: "Search Diversification", href: "/services" },
      { label: "The Opportunity Audit", href: "/services" },
      { label: "The Method", href: "/method" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "News", href: "/news" },
      { label: "Careers", href: "/careers" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Blog", href: "/blog" },
      { label: "Podcast", href: "/podcast" },
      { label: "Report", href: "/report" },
      { label: "Case Studies", href: "/case-studies" },
      { label: "Google Agency Directory", href: "/google-ads-agency-directory" },
    ],
  },
  {
    title: "Governance",
    links: [
      { label: "Why Microsoft", href: "/why-microsoft" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];
---
<footer class="bg-ink text-paper">
  <div class="wrap section-tight">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <Wordmark variant="dark" />
        <p class="mt-4 max-w-xs text-sm text-white/70">
          The UK's specialist Microsoft Advertising agency. Google is where you
          spend. Microsoft is where you grow.
        </p>
        <div class="mt-5">
          <PartnerBadge size="sm" variant="dark" />
        </div>
        <p class="mt-5 text-sm text-white/60">London, United Kingdom</p>
        <div class="mt-4 flex gap-4 text-sm">
          <a href={socials.linkedin} class="text-white/70 hover:text-paper" rel="noopener" target="_blank">LinkedIn</a>
          <a href={socials.youtube} class="text-white/70 hover:text-paper" rel="noopener" target="_blank">YouTube</a>
          <a href={socials.spotify} class="text-white/70 hover:text-paper" rel="noopener" target="_blank">Spotify</a>
        </div>
      </div>
      {
        cols.map((col) => (
          <div>
            <p class="font-display text-sm font-semibold text-white/90">{col.title}</p>
            <ul class="mt-3 space-y-2">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-white/65 hover:text-paper">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/15 pt-6 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 {AGENCY}</p>
      <div class="flex gap-4">
        <a href="/llms.txt" class="hover:text-paper">llms.txt</a>
        <a href="/rss.xml" class="hover:text-paper">RSS</a>
        <a href="/privacy" class="hover:text-paper">Privacy</a>
        <a href="/terms" class="hover:text-paper">Terms</a>
      </div>
    </div>
  </div>
</footer>
