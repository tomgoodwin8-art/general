---
interface Props {
  kicker?: string;
  title: string;
  intro?: string;
}
const { kicker, title, intro } = Astro.props;
---
<section class="border-b border-line bg-mist">
  <div class="wrap section-tight">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="mt-3 max-w-4xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg text-slate">{intro}</p>}
  </div>
</section>
