---
/**
 * PostThumb.astro — generated, on-brand thumbnail for a blog post.
 * Deterministic colour per category, the Microsoft four-square motif, and the
 * category label. Decorative (the post title sits alongside), so aria-hidden.
 * No external image assets, so it stays fast and never 404s.
 */
interface Props {
  category: string;
  ratio?: "card" | "wide";
  class?: string;
}
const { category, ratio = "card", class: cls = "" } = Astro.props;

// Deep, white-text-safe brand tones, keyed by category. Falls back to blue.
const palette: Record<string, [string, string]> = {
  Platform: ["#0078D4", "#0A4E8A"],
  Strategy: ["#15202B", "#243B53"],
  "How-to": ["#1F6FB2", "#0B3E6F"],
  Targeting: ["#243B53", "#10212F"],
  Measurement: ["#0B5394", "#06365F"],
  "AI Search": ["#103A5A", "#0A2740"],
  Industry: ["#2D3A45", "#161F27"],
  Vertical: ["#1A4971", "#0C2C46"],
  Resource: ["#34506A", "#1A2C3C"],
};
const [c1, c2] = palette[category] ?? ["#0078D4", "#0A4E8A"];
const vb = ratio === "wide" ? "0 0 1200 420" : "0 0 600 360";
const gid = `g-${category.replace(/[^a-z0-9]/gi, "")}`;
---
<svg
  class={`block h-full w-full ${cls}`}
  viewBox={vb}
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1} />
      <stop offset="1" stop-color={c2} />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${gid})`} />
  <!-- faint oversized four-square motif -->
  <g opacity="0.10" transform="translate(62 60) scale(1.0)">
    <rect x="0" y="0" width="120" height="120" fill="#fff" />
    <rect x="132" y="0" width="120" height="120" fill="#fff" />
    <rect x="0" y="132" width="120" height="120" fill="#fff" />
    <rect x="132" y="132" width="120" height="120" fill="#fff" />
  </g>
  <!-- crisp brand four-square mark -->
  <g transform="translate(40 40)">
    <rect x="0" y="0" width="22" height="22" fill="#F25022" />
    <rect x="26" y="0" width="22" height="22" fill="#7FBA00" />
    <rect x="0" y="26" width="22" height="22" fill="#00A4EF" />
    <rect x="26" y="26" width="22" height="22" fill="#FFB900" />
  </g>
  <text
    x="40"
    y={ratio === "wide" ? 360 : 312}
    fill="#ffffff"
    font-family="'Space Grotesk',Inter,system-ui,sans-serif"
    font-size={ratio === "wide" ? 40 : 34}
    font-weight="700"
    letter-spacing="-0.5"
  >{category}</text>
  <text
    x="40"
    y={ratio === "wide" ? 392 : 340}
    fill="#ffffff"
    opacity="0.7"
    font-family="Inter,system-ui,sans-serif"
    font-size={ratio === "wide" ? 20 : 17}
  >The Micro Agency</text>
</svg>
