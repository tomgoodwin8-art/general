---
/**
 * PostThumb.astro — generated, on-brand thumbnail for a blog post.
 * Deterministic colour per category with a generic abstract geometric motif
 * (no Microsoft mark). Decorative (the post title sits alongside), so
 * aria-hidden. No external image assets, so it stays fast and never 404s.
 */
interface Props {
  category: string;
  ratio?: "card" | "wide";
  class?: string;
}
const { category, ratio = "card", class: cls = "" } = Astro.props;

// Deep, white-text-safe brand tones, keyed by category. Falls back to blue.
const palette: Record<string, [string, string]> = {
  Platform: ["#0078D4", "#0A4E8A"],
  Strategy: ["#15202B", "#243B53"],
  "How-to": ["#1F6FB2", "#0B3E6F"],
  Targeting: ["#243B53", "#10212F"],
  Measurement: ["#0B5394", "#06365F"],
  "AI Search": ["#103A5A", "#0A2740"],
  Industry: ["#2D3A45", "#161F27"],
  Vertical: ["#1A4971", "#0C2C46"],
  Resource: ["#34506A", "#1A2C3C"],
};
const [c1, c2] = palette[category] ?? ["#0078D4", "#0A4E8A"];

// viewBox ratios match the container aspect ratios exactly (wide 5:2, card 5:3)
// so preserveAspectRatio="slice" never crops the labels at the edges.
const wide = ratio === "wide";
const W = wide ? 1200 : 600;
const H = wide ? 480 : 360;
const gid = `g-${category.replace(/[^a-z0-9]/gi, "")}`;

// Small deterministic variation so categories don't all look identical.
const seed = category.length;
const cx = W - (90 + (seed % 5) * 22);
const cy = 70 + (seed % 4) * 18;
---
<svg
  class={`block h-full w-full ${cls}`}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1} />
      <stop offset="1" stop-color={c2} />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${gid})`} />

  <!-- generic abstract motif: concentric rings + thin diagonals -->
  <g fill="none" stroke="#ffffff" stroke-opacity="0.14" stroke-width="2">
    <circle cx={cx} cy={cy} r="58" />
    <circle cx={cx} cy={cy} r="98" />
    <circle cx={cx} cy={cy} r="138" />
  </g>
  <g stroke="#ffffff" stroke-opacity="0.10" stroke-width="2">
    <line x1="0" y1={H * 0.35} x2={W} y2={H * 0.05} />
    <line x1="0" y1={H * 0.6} x2={W} y2={H * 0.28} />
  </g>
  <!-- small solid accent dot -->
  <circle cx={cx} cy={cy} r="7" fill="#ffffff" fill-opacity="0.85" />

  <text
    x="40"
    y={wide ? 410 : 312}
    fill="#ffffff"
    font-family="'Space Grotesk',Inter,system-ui,sans-serif"
    font-size={wide ? 40 : 34}
    font-weight="700"
    letter-spacing="-0.5"
  >{category}</text>
  <text
    x="40"
    y={wide ? 444 : 340}
    fill="#ffffff"
    opacity="0.7"
    font-family="Inter,system-ui,sans-serif"
    font-size={wide ? 20 : 17}
  >The Micro Agency</text>
</svg>
