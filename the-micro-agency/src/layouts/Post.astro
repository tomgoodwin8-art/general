---
/**
 * Post.astro (§5) — blog/podcast article layout.
 * Breadcrumbs, header, prose body slot, "Book an audit" CTA at the foot.
 */
import Base from "./Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import AuditCTA from "../components/AuditCTA.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  kicker?: string;
  meta?: string;
  crumbs: { label: string; href: string }[];
  schemaNodes?: Record<string, unknown>[];
}
const { title, description, path, kicker, meta, crumbs, schemaNodes } =
  Astro.props;
---
<Base {title} {description} {path} type="article" schemaNodes={schemaNodes}>
  <article>
    <div class="border-b border-line bg-mist">
      <div class="wrap-narrow py-10">
        <Breadcrumb {crumbs} />
        {kicker && <p class="kicker mt-6">{kicker}</p>}
        <h1 class="mt-3 text-3xl sm:text-4xl">{title}</h1>
        {meta && <p class="mt-4 text-sm text-slate">{meta}</p>}
      </div>
    </div>

    <div class="wrap-narrow py-12">
      <div class="prose">
        <slot />
      </div>
    </div>

    <slot name="after" />

    <AuditCTA />
  </article>
</Base>
