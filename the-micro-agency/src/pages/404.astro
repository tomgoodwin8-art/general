---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page does not exist." noindex>
  <section class="section">
    <div class="wrap-narrow text-center">
      <p class="figure text-5xl">404</p>
      <h1 class="mt-4">That page is not here</h1>
      <p class="mt-4 text-slate">
        The link may be out of date. Try the homepage, or book an audit.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-ghost">Home</a>
        <a href="/contact" class="btn btn-primary">Contact</a>
      </div>
    </div>
  </section>
</Base>
