---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import AuditCTA from "../../components/AuditCTA.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base
  title="Blog & Insights"
  description="Practical, evidence-led writing on Microsoft Advertising, search diversification, incrementality and the Microsoft ecosystem."
>
  <PageHeader
    kicker="Blog & Insights"
    title="Microsoft Advertising, without the hand-waving"
    intro="Evidence before assertion. Platform nuance for performance leaders who already know the fundamentals."
  />

  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p) => (
          <a
            href={`/blog/${p.id}`}
            class="flex flex-col rounded-xl border border-line bg-paper p-6 transition hover:border-ms-blue-deep"
          >
            <div class="flex items-center gap-2 text-xs">
              <span class="kicker">{p.data.category}</span>
            </div>
            <h2 class="mt-3 text-lg">{p.data.title}</h2>
            <p class="mt-3 line-clamp-3 text-sm text-slate">{p.data.description}</p>
            <span class="mt-4 text-xs text-slate">{fmt(p.data.pubDate)} · {p.data.author}</span>
          </a>
        ))
      }
    </div>
  </section>

  <AuditCTA />
</Base>
