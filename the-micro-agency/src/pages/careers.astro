---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { CONTACT_EMAIL } from "../data/site";
const emailUser = CONTACT_EMAIL.split("@")[0];
const emailDomain = CONTACT_EMAIL.split("@")[1];
---
<Base
  title="Careers"
  description="A lean, senior boutique where the people who win the work do the work. Microsoft Advertising specialists, get in touch."
>
  <PageHeader
    kicker="Careers"
    title="The people who win the work do the work"
    intro="We are a lean, senior boutique. No layers, no juniors learning on your account, no channel nobody wanted. If you are a Microsoft Advertising specialist who would rather go deep than broad, we should talk."
  />

  <section class="section">
    <div class="wrap-narrow">
      <div class="rounded-xl border border-line bg-mist p-8">
        <h2 class="text-xl">Open roles</h2>
        <p class="mt-3 text-slate">
          No open roles right now. We hire when there is real work for a
          specialist, not to fill a chart. If that is you, send a note and we
          will keep it on file.
        </p>
        <p class="mt-4 text-sm">
          <a
            class="link"
            data-user={emailUser}
            data-domain={emailDomain}
            href="#"
            onclick={`this.href='mailto:'+this.dataset.user+'@'+this.dataset.domain`}
            >{emailUser}<span aria-hidden="true"> [at] </span>{emailDomain}</a
          >
        </p>
      </div>
    </div>
  </section>
</Base>
