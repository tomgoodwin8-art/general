---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AuditCTA from "../components/AuditCTA.astro";
import { BOOKING_URL } from "../data/site";
---
<Base
  title="Case studies"
  description="Case studies are in progress. We are working with our first cohort of brands and will publish results here as they are signed off."
>
  <PageHeader
    kicker="Case Studies"
    title="Results, as soon as they are signed off"
  />

  <section class="section">
    <div class="wrap-narrow">
      <div class="rounded-2xl border border-line bg-mist p-9 text-center">
        <h2 class="text-2xl">Case studies are in progress.</h2>
        <p class="mx-auto mt-4 max-w-xl text-slate">
          We are working with our first cohort of brands and will publish results
          here as they are signed off. Specificity is the whole promise, so we
          will not publish a number until the client has approved it.
        </p>
        <p class="mt-2 text-slate">Want to be one of them?</p>
        <a href={BOOKING_URL} class="btn btn-primary mt-6" rel="noopener" target="_blank">
          Book an audit
        </a>
      </div>
    </div>
  </section>

  <AuditCTA />
</Base>
