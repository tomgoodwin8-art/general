---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import CalEmbed from "../components/CalEmbed.astro";

const checklist = [
  "20 minutes, no pitch, no obligation.",
  "We will tell you honestly if Microsoft Ads is not the right move for you.",
  "You leave with a clear next step either way.",
];
---
<Base
  title="Contact: book an audit or send a brief"
  description="Twenty minutes to see whether there is incremental revenue worth chasing on Microsoft Ads. Book an audit call, or send a brief."
>
  <PageHeader
    kicker="Contact"
    title="Book a call, or send a brief"
    intro="No pitch. A short, honest conversation about whether Microsoft Ads can add incremental revenue in your account."
  />

  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:items-start">
      <!-- Left: book an audit -->
      <div>
        <h2 class="text-2xl">Book an audit call</h2>
        <p class="mt-3 text-slate">
          Twenty minutes to see whether there is incremental revenue worth
          chasing.
        </p>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            checklist.map((c) => (
              <li class="flex gap-2.5">
                <span class="font-bold text-ms-blue-deep" aria-hidden="true">✓</span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6">
          <CalEmbed />
        </div>
      </div>

      <!-- Right: send a brief -->
      <div class="rounded-2xl border border-line bg-paper p-7">
        <h2 class="text-2xl">Send a brief</h2>
        <p class="mt-2 text-sm text-slate">
          Only name, email and a message are required. The rest helps us prepare.
        </p>
        <div class="mt-5">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>
