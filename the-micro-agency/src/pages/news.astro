---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AuditCTA from "../components/AuditCTA.astro";

const items = (await getCollection("news", (n) => !n.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base
  title="News"
  description="Press, partner announcements and report launches from The Micro Agency."
>
  <PageHeader kicker="News" title="News and announcements" />

  <section class="section">
    <div class="wrap-narrow">
      {
        items.length === 0 ? (
          <div class="rounded-xl border border-line bg-mist p-8 text-center text-slate">
            <p>No news yet. Announcements, partner updates and report launches will appear here.</p>
          </div>
        ) : (
          <ul class="divide-y divide-line border-y border-line">
            {items.map((n) => (
              <li class="py-5">
                <p class="kicker">{fmt(n.data.pubDate)}</p>
                <h2 class="mt-2 text-xl">
                  {n.data.url ? (
                    <a href={n.data.url} class="link" rel="noopener" target="_blank">
                      {n.data.title}
                    </a>
                  ) : (
                    n.data.title
                  )}
                </h2>
                <p class="mt-2 text-slate">{n.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <AuditCTA />
</Base>
