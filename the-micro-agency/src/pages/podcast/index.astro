---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import AuditCTA from "../../components/AuditCTA.astro";
import { socials } from "../../data/site";

const episodes = (await getCollection("podcast", (e) => !e.data.draft)).sort(
  (a, b) => b.data.episode - a.data.episode
);
const latest = episodes[0];
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base
  title="The Diversification Podcast"
  description="A show on search diversification, performance measurement and the Microsoft ecosystem. On YouTube and Spotify."
>
  <PageHeader
    kicker="The Diversification Podcast"
    title="The conversation performance teams aren't having"
    intro="Search diversification, incrementality and the Microsoft ecosystem, in plain terms, for people who already know ROAS from a hole in the ground."
  />

  <section class="section-tight">
    <div class="wrap flex flex-wrap gap-3">
      <a href={socials.youtube} class="btn btn-ghost" rel="noopener" target="_blank">YouTube</a>
      <a href={socials.spotify} class="btn btn-ghost" rel="noopener" target="_blank">Spotify</a>
      <!-- [Apple Podcasts TODO] -->
      <a href="/rss.xml" class="btn btn-ghost">RSS</a>
    </div>
  </section>

  {
    latest && (
      <section class="section-tight">
        <div class="wrap rounded-2xl border border-line bg-mist p-8">
          <p class="kicker">Latest episode</p>
          <h2 class="mt-3 text-2xl">
            Ep {latest.data.episode}. {latest.data.title}
          </h2>
          <p class="mt-3 max-w-2xl text-slate">{latest.data.description}</p>
          <a href={`/podcast/${latest.id}`} class="btn btn-primary mt-5">
            Open episode →
          </a>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap grid gap-4">
      {
        episodes.map((e) => (
          <a
            href={`/podcast/${e.id}`}
            class="flex flex-col gap-2 rounded-xl border border-line bg-paper p-6 transition hover:border-ms-blue-deep sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <span class="figure text-sm">EP {String(e.data.episode).padStart(2, "0")}</span>
              <h3 class="mt-1 text-lg">{e.data.title}</h3>
            </div>
            <span class="text-xs text-slate">
              {e.data.duration ? `${e.data.duration} · ` : ""}
              {fmt(e.data.pubDate)}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <AuditCTA />
</Base>
