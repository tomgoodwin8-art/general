---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AuditCTA from "../components/AuditCTA.astro";
import FAQ from "../components/FAQ.astro";
import { BOOKING_URL } from "../data/site";
import { servicesFaqs } from "../data/faqs";
import { faqSchema } from "../lib/schema";

const schemaNodes = [faqSchema(servicesFaqs)];

const services = [
  {
    name: "Managed Microsoft Advertising",
    who: "Brands that want Microsoft run properly, not parked.",
    what: "Platform-native build and optimisation across Search, Shopping, Audience Network and LinkedIn-targeted campaigns. Monthly management on a clear fee, no percentage-of-spend games that reward bloat.",
    cost: "Monthly retainer, fixed fee. [Pricing TODO: confirm fee model]",
    cta: { label: "Book an audit", href: BOOKING_URL, external: true },
  },
  {
    name: "Search Diversification Strategy",
    who: "Performance leaders and CFOs evaluating how search budget should be allocated across engines.",
    what: "A premium advisory engagement: concentration-risk analysis, incrementality design, and a reallocation plan your finance team will sign off.",
    cost: "Fixed-scope advisory engagement. [Pricing TODO: confirm fee model]",
    cta: { label: "Send a brief", href: "/contact", external: false },
  },
  {
    name: "The Opportunity Audit",
    who: "Anyone weighing whether Microsoft is worth the effort, before committing.",
    what: "A fixed-fee analysis that quantifies the incremental revenue available from Microsoft Ads in your account, before you commit to anything.",
    cost: "Fixed fee, credited against the first month if you proceed. [Pricing TODO: confirm fee model]",
    cta: { label: "Book an audit", href: BOOKING_URL, external: true },
  },
];
---
<Base
  title="For Brands: Microsoft Advertising services"
  description="Managed Microsoft Advertising, Search Diversification Strategy and a fixed-fee Opportunity Audit. Platform-native, built for the Microsoft ecosystem from the ground up."
  schemaNodes={schemaNodes}
>
  <PageHeader
    kicker="For Brands"
    title="What we do for performance teams"
    intro="Three ways to work with a Microsoft specialist, from a fixed-fee first look to full platform-native management. No imported Google campaigns. No percentage-of-spend incentives that reward bloat."
  />

  <section class="section">
    <div class="wrap flex flex-col gap-6">
      {
        services.map((s) => (
          <div class="grid gap-6 rounded-xl border border-line bg-paper p-7 md:grid-cols-[1.4fr_1fr] md:p-9">
            <div>
              <h2 class="text-2xl">{s.name}</h2>
              <p class="mt-4 text-slate">{s.what}</p>
            </div>
            <dl class="flex flex-col gap-4 border-t border-line pt-5 md:border-l md:border-t-0 md:pl-7 md:pt-0">
              <div>
                <dt class="kicker">Who it is for</dt>
                <dd class="mt-1 text-sm text-slate">{s.who}</dd>
              </div>
              <div>
                <dt class="kicker">What it costs</dt>
                <dd class="mt-1 text-sm text-slate">{s.cost}</dd>
              </div>
              <a
                href={s.cta.href}
                class="btn btn-primary mt-2 w-full"
                rel={s.cta.external ? "noopener" : undefined}
                target={s.cta.external ? "_blank" : undefined}
              >
                {s.cta.label}
              </a>
            </dl>
          </div>
        ))
      }
    </div>
  </section>

  <FAQ faqs={servicesFaqs} heading="Services FAQ" />

  <AuditCTA />
</Base>
