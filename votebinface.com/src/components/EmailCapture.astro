---
// Email capture with double opt-in language (brief §5.1). Posts to a
// Cloudflare Pages Function stub (functions/subscribe.ts). Progressive
// enhancement: works as a normal POST, upgraded to fetch by the inline script.
---
<form
  id="email-form"
  action="/subscribe"
  method="POST"
  class="rounded-lg border border-line bg-void p-6 sm:p-8"
>
  <p class="eyebrow">Stay in the loop</p>
  <h2 class="mt-2 text-3xl">Get campaign updates.</h2>
  <p class="mt-2 text-sm text-grey">
    We will send a confirmation link first: you are only added once you click it (double opt-in). No spam, no selling your data, unsubscribe any time. See our
    <a href="/privacy" class="text-hazard underline underline-offset-2">privacy notice</a>.
  </p>
  <div class="mt-5 flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for="email">Email address</label>
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="min-h-[52px] flex-1 rounded border border-line bg-ink px-4 py-3 text-chrome placeholder:text-grey focus:border-hazard"
    />
    <button type="submit" class="inline-flex min-h-[52px] items-center justify-center rounded bg-pop px-6 font-mono text-sm font-bold uppercase tracking-wider text-white hover:bg-[#ff1a5f]">
      Sign up
    </button>
  </div>
  <label class="mt-4 flex items-start gap-2 text-xs text-grey">
    <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 accent-[#ff2d6e]" />
    <span>I agree to receive campaign updates by email and I have read the privacy notice.</span>
  </label>
  <p id="email-status" class="mt-3 font-mono text-xs" role="status" aria-live="polite"></p>
</form>
<script>
  const form = document.getElementById('email-form') as HTMLFormElement | null;
  const status = document.getElementById('email-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (status) { status.textContent = 'Sending…'; status.style.color = '#a7adb6'; }
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error('bad status');
      form.reset();
      if (status) { status.textContent = 'Almost there: check your inbox for a confirmation link.'; status.style.color = '#f5e000'; }
    } catch {
      if (status) { status.textContent = 'Something went wrong. Please try again shortly.'; status.style.color = '#ff2d6e'; }
    }
  });
</script>
