---
// The chrome bin-helmet mascot (brief §3, device 3). Original SVG artwork,
// built once and reused. Eyes are hazard-yellow rounded rects in a black
// visor slot. Decorative by default; pass a `title` to make it meaningful.
interface Props {
  class?: string;
  title?: string;
  bob?: boolean;
}
const { class: className = '', title, bob = false } = Astro.props;
const decorative = !title;
---
<svg
  class:list={[className, { bob }]}
  viewBox="0 0 200 260"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <defs>
    <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f4f6f8" />
      <stop offset="0.45" stop-color="#c3c8cf" />
      <stop offset="0.55" stop-color="#eef1f4" />
      <stop offset="1" stop-color="#9aa0a8" />
    </linearGradient>
    <linearGradient id="chromeDark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#c9ced5" />
      <stop offset="1" stop-color="#7f858d" />
    </linearGradient>
  </defs>

  <!-- Lid handle -->
  <rect x="82" y="8" width="36" height="12" rx="6" fill="url(#chromeDark)" stroke="#5b616b" stroke-width="1.5" />
  <!-- Lid -->
  <path d="M34 40c0-11 30-20 66-20s66 9 66 20l-6 14H40z" fill="url(#chrome)" stroke="#5b616b" stroke-width="2" />
  <!-- Body of the bin helmet -->
  <path d="M40 54h120l-10 150c-.6 9-8 16-17 16H67c-9 0-16.4-7-17-16z" fill="url(#chrome)" stroke="#5b616b" stroke-width="2" />

  <!-- Vertical ribs -->
  <g stroke="#aeb4bc" stroke-width="2" opacity="0.7">
    <line x1="66" y1="70" x2="61" y2="205" />
    <line x1="86" y1="70" x2="84" y2="210" />
    <line x1="114" y1="70" x2="116" y2="210" />
    <line x1="134" y1="70" x2="139" y2="205" />
  </g>

  <!-- Visor slot (black) -->
  <rect x="58" y="92" width="84" height="34" rx="8" fill="#0b0b0c" />
  <!-- Hazard-yellow eyes -->
  <rect x="70" y="103" width="24" height="12" rx="5" fill="#f5e000" />
  <rect x="106" y="103" width="24" height="12" rx="5" fill="#f5e000" />

  <!-- Square mouth slot -->
  <rect x="88" y="150" width="24" height="24" rx="3" fill="#0b0b0c" />

  <!-- Rim highlight -->
  <path d="M40 54h120" stroke="#ffffff" stroke-width="1.5" opacity="0.5" />
</svg>
