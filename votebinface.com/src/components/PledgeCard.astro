---
interface Props {
  number: number;
  pledge: string;
  genuine?: boolean;
  href?: string;
}
const { number, pledge, genuine = true, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  href={href}
  class:list={[
    'group relative block rounded-lg border border-line bg-void p-6 transition-colors',
    href ? 'hover:border-hazard' : '',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <span class="font-display text-4xl text-hazard leading-none">{String(number).padStart(2, '0')}</span>
    {genuine && (
      <span class="rounded-full border border-line px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-widest text-grey">
        genuine Binface pledge
      </span>
    )}
  </div>
  <p class="mt-4 font-display text-xl text-chrome leading-tight"><slot>{pledge}</slot></p>
  {href && (
    <span class="mt-4 inline-block font-mono text-xs uppercase tracking-widest text-hazard group-hover:underline">Read why &rarr;</span>
  )}
</Tag>
