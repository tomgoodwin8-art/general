---
// Hazard-yellow stat band (brief §5.1). Big Anton figures on hazard yellow,
// ink text for contrast.
interface Props {
  stats: { figure: string; label: string }[];
}
const { stats } = Astro.props;
---
<section class="hazard-tape">
  <div class="bg-hazard">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 text-ink sm:grid-cols-3">
      {stats.map((s) => (
        <div class="text-center">
          <p class="font-display text-5xl leading-none sm:text-6xl">{s.figure}</p>
          <p class="mt-2 font-mono text-xs font-bold uppercase tracking-widest">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
