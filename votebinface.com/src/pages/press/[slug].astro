---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { SITE } from '../../data/facts';
import { imprintLine } from '../../config/mode';

export async function getStaticPaths() {
  const releases = (await getCollection('press')).filter((p) => !p.data.draft);
  return releases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const displayDate = entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const newsArticle = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.standfirst,
  datePublished: entry.data.date.toISOString(),
  image: `${SITE.url}/og/press.png`,
  author: { '@type': 'Organization', name: 'The Count Binface Party', url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: 'The Count Binface Party',
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      postOfficeBoxNumber: 'PO Box 818',
      addressLocality: 'Tonbridge',
      postalCode: 'TN9 9YF',
      addressCountry: 'GB',
    },
  },
};
---
<BaseLayout
  title={`${entry.data.title.slice(0, 48)} | Vote Binface`}
  description={entry.data.standfirst.slice(0, 155)}
  path={`/press/${entry.id}`}
  ogImage="/og/press.png"
  schema={newsArticle}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Press', path: '/press' },
    { name: entry.data.title, path: `/press/${entry.id}` },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-hazard">
      Press release &middot; <time datetime={entry.data.date.toISOString()}>{displayDate}</time>
    </p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-5 text-lg text-chrome">{entry.data.standfirst}</p>

    <div class="mt-4 flex flex-wrap gap-3">
      <Button href={`/press/${entry.id}.txt`} variant="ghost" external>Download plain text</Button>
      <Button href={`mailto:${entry.data.contactEmail}?subject=${encodeURIComponent(entry.data.title)}`} variant="ghost">Email the press desk</Button>
    </div>

    <div class="mt-8 prose-body prose-press">
      <Content />
    </div>

    <footer class="mt-10 border-t border-line pt-6">
      <p class="font-mono text-xs uppercase tracking-widest text-grey">Quote attributable to</p>
      <p class="mt-1 text-chrome">{entry.data.spokesperson}</p>
      <p class="mt-4 font-mono text-xs text-grey">Press contact: {entry.data.contactEmail}</p>
      <p class="mt-4 font-mono text-xs text-grey">{imprintLine}</p>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .prose-press h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose-press p { margin-bottom: 1.1rem; }
</style>
