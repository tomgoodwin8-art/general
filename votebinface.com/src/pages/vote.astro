---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { SITE } from '../data/facts';

const steps = [
  {
    n: 1,
    title: 'Check you are registered',
    body: 'It takes about five minutes and you need it done before the deadline. If you have moved, changed your name, or are not sure, do it again to be safe.',
    cta: 'Register to vote',
    href: SITE.registerUrl,
    event: 'govuk-register',
  },
  {
    n: 2,
    title: 'Apply for a postal vote',
    body: 'Vote from your kitchen table, in your own time, no queue and no weather. Ideal if getting to a polling station is difficult. You apply once through gov.uk.',
    cta: 'Apply for a postal vote',
    href: SITE.postalUrl,
    event: 'govuk-postal',
  },
  {
    n: 3,
    title: 'Vote on polling day',
    body: `Polling day: ${SITE.pollingDate}. If you are voting in person in England you now need accepted photo ID. No ID? Apply free for a Voter Authority Certificate on gov.uk.`,
    cta: null,
    href: null,
    event: null,
  },
];

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to vote in the Clacton by-election',
  description: 'Register to vote, apply for a postal vote, and vote on polling day in the Clacton by-election.',
  totalTime: 'PT10M',
  step: steps.map((s) => ({
    '@type': 'HowToStep',
    position: s.n,
    name: s.title,
    text: s.body,
    ...(s.href ? { url: s.href } : {}),
  })),
};
---
<BaseLayout
  title="How to vote in the Clacton by-election | Vote Binface"
  description="Register to vote, apply for a postal vote and vote on polling day in the Clacton by-election. Direct links to gov.uk. No sign-up, no gate."
  path="/vote"
  ogImage="/og/vote.png"
  schema={howTo}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'How to vote', path: '/vote' }]}
>
  <!-- Above the fold: zero jokes (brief §5.5). -->
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-8 text-center">
    <p class="eyebrow">Clacton by-election</p>
    <h1 class="mt-3 text-5xl sm:text-7xl">Make your vote count.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-grey">
      Three steps. All of them free. Nothing on this page stands between you and gov.uk.
    </p>
    <div class="mx-auto mt-8 flex max-w-md flex-col gap-3">
      <Button href={SITE.registerUrl} variant="hazard" external full big dataEvent="govuk-register">Register to vote</Button>
      <Button href={SITE.postalUrl} variant="hazard" external full big dataEvent="govuk-postal">Apply for a postal vote</Button>
    </div>
  </section>

  <!-- Three-step visual -->
  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="flex flex-col rounded-lg border border-line bg-void p-6">
          <span class="font-display text-5xl text-hazard leading-none">{s.n}</span>
          <h2 class="mt-3 text-2xl">{s.title}</h2>
          <p class="mt-3 flex-1 text-sm text-grey">{s.body}</p>
          {s.href && (
            <div class="mt-5">
              <Button href={s.href} variant="hazard" external full big dataEvent={s.event ?? undefined}>{s.cta}</Button>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Deadlines block, config-driven (brief §5.5). -->
  <section class="mx-auto max-w-5xl px-4 py-6">
    <div class="rounded-lg border border-line bg-void p-6">
      <h2 class="text-2xl">Key deadlines</h2>
      <p class="mt-1 text-sm text-grey">Confirmed by Tendring District Council once the writ is issued. Do not leave it late.</p>
      <dl class="mt-5 grid gap-4 sm:grid-cols-3">
        <div>
          <dt class="eyebrow">Register by</dt>
          <dd class="mt-1 text-chrome">{SITE.registrationDeadline}</dd>
        </div>
        <div>
          <dt class="eyebrow">Postal vote by</dt>
          <dd class="mt-1 text-chrome">{SITE.postalDeadline}</dd>
        </div>
        <div>
          <dt class="eyebrow">Polling day</dt>
          <dd class="mt-1 text-chrome">{SITE.pollingDate}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Secondary block -->
  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="rounded-lg border border-hazard/40 bg-void p-6">
      <h2 class="text-2xl">Not in Clacton? Your job is different.</h2>
      <p class="mt-3 max-w-2xl text-grey">
        Only registered electors in the Clacton constituency can vote in this by-election. If you live elsewhere, the most useful thing you can do is help other people turn up.
        <a href="/volunteer" class="text-hazard underline underline-offset-2">Join a BinAid weekend</a>, or send this page to someone who does live in Clacton.
      </p>
      <div class="mt-6">
        <ShareButtons />
      </div>
    </div>
  </section>
</BaseLayout>
